---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { withBase } from '../lib/site';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { title, description, img, redirect, developedDate } = project.data;
const href = redirect ?? withBase(`/projects/${project.id}`);
const external = Boolean(redirect);
const year = developedDate?.getFullYear();
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  data-evo-block
  class="group flex flex-col overflow-hidden rounded-xl border border-ink-200 bg-white/80 backdrop-blur-sm transition-all hover:-translate-y-0.5 hover:shadow-lg dark:border-ink-800 dark:bg-ink-950/80 dark:hover:shadow-ink-900/50"
>
  {
    img && (
      <div class="aspect-[16/9] overflow-hidden bg-ink-100 dark:bg-ink-900">
        <img
          src={withBase(img)}
          alt={`Preview of ${title}`}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        />
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-4">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-serif text-lg font-semibold text-ink-900 group-hover:text-accent-700 dark:text-ink-100 dark:group-hover:text-accent-400">
        {title}
      </h3>
      {external && <Icon name="external" class="mt-1 h-4 w-4 shrink-0 text-ink-300 group-hover:text-accent-600 dark:text-ink-600" />}
    </div>
    {description && <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600 dark:text-ink-400">{description}</p>}
    {year && <p class="mt-3 text-xs font-medium text-ink-400 dark:text-ink-500">{year}</p>}
  </div>
</a>
