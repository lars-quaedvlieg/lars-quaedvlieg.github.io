---
import { TIMELINE } from '../data/timeline';

const typeStyles: Record<string, string> = {
  work: 'bg-accent-500',
  education: 'bg-indigo-500',
  award: 'bg-amber-500',
};
---

<ol class="relative ml-3 border-l-2 border-ink-200 dark:border-ink-800">
  {
    TIMELINE.map((entry) => (
      <li class="relative mb-8 pl-6 last:mb-0">
        <span class:list={['absolute top-1.5 -left-[7px] h-3 w-3 rounded-full ring-4 ring-white dark:ring-ink-950', typeStyles[entry.type]]} />
        <p class="text-xs font-semibold tracking-wide text-ink-400 uppercase dark:text-ink-500">{entry.period}</p>
        <h3 class="mt-0.5 font-semibold text-ink-900 dark:text-ink-100">
          {entry.title}
          {' · '}
          {entry.orgUrl ? (
            <a href={entry.orgUrl} target="_blank" rel="noopener" class="text-accent-700 hover:underline dark:text-accent-400">
              {entry.org}
            </a>
          ) : (
            entry.org
          )}
        </h3>
        {entry.description && (
          <p
            class="mt-1 text-sm text-ink-600 dark:text-ink-400 [&_a]:text-accent-700 [&_a]:underline [&_a]:underline-offset-2 dark:[&_a]:text-accent-400"
            set:html={entry.description}
          />
        )}
      </li>
    ))
  }
</ol>
