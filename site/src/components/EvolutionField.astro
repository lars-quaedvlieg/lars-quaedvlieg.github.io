---
// Full-page generative layer: evolutionary search over the page-as-score-landscape.
//
//   · the page IS the fitness surface, and you can see it: a procedural
//     terrain of peaks rendered as a quantized heatmap with numeric summit
//     scores; content blocks are SACRED ground (zero score, never overgrown)
//   · several independent ISLANDS spawn, each a short hike away from a score
//     cluster — so you can watch each one evolve toward the high ground
//   · islands never interbreed; each grows its own lineage DAG (a node can
//     have two parents from ITS island), scored by the ground it lands on:
//     bright = improved, amber = worse, red = failed program
//   · peaks DEPLETE as populations feed (bands shrink, summit scores tick
//     down); when the whole terrain is spent, the expedition retires and a
//     new one begins over fresh terrain
---

<div id="evo-field" class="pointer-events-none absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
  <canvas id="evo-canvas" class="absolute inset-0 h-full w-full"></canvas>
</div>
<p
  id="evo-stats"
  class="pointer-events-none fixed right-3 bottom-2 z-20 font-mono text-[10px] tracking-widest text-ink-400/70 uppercase select-none dark:text-ink-500/70"
  aria-hidden="true"
>
  expedition 1 · best 0.000
</p>

<script>
  const field = document.getElementById('evo-field')!;
  const canvas = document.getElementById('evo-canvas') as HTMLCanvasElement;
  const statsEl = document.getElementById('evo-stats')!;
  const ctx = canvas.getContext('2d')!;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mobile = window.innerWidth < 640;

  /* ----------------------- tuning ----------------------- */
  const N_ISLANDS = mobile ? 3 : 5;
  const POP_TOTAL = mobile ? 70 : 150;   // living nodes across all islands
  const SAMPLE_EVERY = mobile ? 26 : 15; // frames between beats, per island
  const GROW_FRAMES = 22;
  const FAIL_P = 0.1;
  const FAIL_TTL = 320;
  const PRUNE_EVERY = 280;
  const CROSS_P = 0.4;          // chance a beat samples TWO parents (same island)
  const PAD = 16;               // sacred margin around content blocks
  const RECENCY = 0.0005;       // sampling decay per frame of age
  const DEPLETE = 0.0035;       // peak energy drain per occupant per check
  const HOME_DIST = 1.2;        // island spawn distance, in units of peak sigma
  const STEP = () => (mobile ? 36 : 46) + Math.random() * 30;
  const HUES = [172, 205, 260, 140, 305, 95];
  const CELL = mobile ? 22 : 18; // heatmap resolution (css px per cell)
  const ISLAND_CAP = Math.floor(POP_TOTAL / N_ISLANDS);

  let w = 0, h = 0, dpr = 1;
  function resize() {
    w = field.clientWidth;
    h = field.clientHeight;
    dpr = Math.min(window.devicePixelRatio || 1, 1.75, Math.sqrt(26e6 / Math.max(1, w * h)));
    canvas.width = Math.floor(w * dpr);
    canvas.height = Math.floor(h * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  resize();

  /* ---------------- landscape ---------------- */
  interface Rect { x: number; y: number; w: number; h: number }
  interface Peak { x: number; y: number; amp: number; sigma: number; energy: number }
  let blocks: Rect[] = [];
  let peaks: Peak[] = [];

  function collect() {
    const fr = field.getBoundingClientRect();
    blocks = [...document.querySelectorAll('[data-evo-block]')].map((el) => {
      const r = el.getBoundingClientRect();
      return { x: r.left - fr.left - PAD, y: r.top - fr.top - PAD, w: r.width + PAD * 2, h: r.height + PAD * 2 };
    });
  }

  function insideBlock(x: number, y: number): boolean {
    for (const b of blocks) {
      if (x > b.x && x < b.x + b.w && y > b.y && y < b.y + b.h) return true;
    }
    return false;
  }

  /** Procedural terrain: random peaks in the whitespace between the content. */
  function generatePeaks() {
    peaks = [];
    const K = Math.max(4, Math.min(10, Math.round(h / 550)));
    for (let k = 0; k < K; k++) {
      const bandY = ((k + 0.3 + Math.random() * 0.4) / K) * h;
      let best: Peak | null = null;
      let bestD = -1;
      for (let c = 0; c < 24; c++) {
        const x = 40 + Math.random() * (w - 80);
        const y = Math.max(60, Math.min(h - 60, bandY + (Math.random() - 0.5) * 220));
        if (insideBlock(x, y)) continue;
        const dPeaks = peaks.length ? Math.min(...peaks.map((p) => Math.hypot(p.x - x, p.y - y))) : 9999;
        if (dPeaks > bestD) {
          bestD = dPeaks;
          best = { x, y, amp: 0.55 + Math.random() * 0.45, sigma: 130 + Math.random() * 90, energy: 1 };
        }
      }
      if (best) peaks.push(best);
    }
  }

  /** Terrain-only score (what the heatmap shows). */
  function terrain(x: number, y: number): number {
    if (x < 14 || y < 14 || x > w - 14 || y > h - 14) return 0;
    if (insideBlock(x, y)) return 0; // sacred ground
    let f = 0.06;
    for (const pk of peaks) {
      const d2 = (x - pk.x) ** 2 + (y - pk.y) ** 2;
      if (d2 < pk.sigma * pk.sigma * 9) f += pk.amp * pk.energy * Math.exp(-d2 / (2 * pk.sigma * pk.sigma));
    }
    return Math.min(1, f);
  }

  let mouse: { x: number; y: number } | null = null;
  window.addEventListener('pointermove', (e) => {
    const fr = field.getBoundingClientRect();
    mouse = { x: e.clientX - fr.left, y: e.clientY - fr.top };
  });

  /** What the search optimizes: terrain + the visitor's cursor. */
  function fitness(x: number, y: number): number {
    let f = terrain(x, y);
    if (f > 0 && mouse) {
      const d2 = (x - mouse.x) ** 2 + (y - mouse.y) ** 2;
      f += 0.4 * Math.exp(-d2 / (2 * 150 * 150));
    }
    return Math.min(1, f);
  }

  const isDark = () => document.documentElement.classList.contains('dark');

  /* ---------------- visible score surface (heatmap) ---------------- */
  const heat = document.createElement('canvas');
  const hctx = heat.getContext('2d')!;
  function drawHeatmap() {
    const dark = isDark();
    const gw = Math.max(1, Math.ceil(w / CELL));
    const gh = Math.max(1, Math.ceil(h / CELL));
    heat.width = gw;
    heat.height = gh;
    const img = hctx.createImageData(gw, gh);
    const [cr, cg, cb] = dark ? [45, 212, 191] : [13, 148, 136];
    const maxA = dark ? 0.24 : 0.15;
    for (let gy = 0; gy < gh; gy++) {
      for (let gx = 0; gx < gw; gx++) {
        const f = terrain(gx * CELL + CELL / 2, gy * CELL + CELL / 2);
        const i = (gy * gw + gx) * 4;
        if (f <= 0.075) continue;
        const level = Math.ceil(Math.min(1, f) * 6) / 6;
        img.data[i] = cr;
        img.data[i + 1] = cg;
        img.data[i + 2] = cb;
        img.data[i + 3] = Math.floor(level * maxA * 255);
      }
    }
    hctx.putImageData(img, 0, 0);
  }

  function drawLandscape(dark: boolean) {
    ctx.imageSmoothingEnabled = true;
    ctx.drawImage(heat, 0, 0, heat.width, heat.height, 0, 0, w, h);
    ctx.font = '10px ui-monospace, SFMono-Regular, Menlo, monospace';
    ctx.textAlign = 'center';
    for (const pk of peaks) {
      const v = pk.amp * pk.energy;
      const a = 0.3 + v * 0.5;
      ctx.strokeStyle = dark ? `hsla(172, 60%, 70%, ${a * 0.5})` : `hsla(172, 60%, 30%, ${a * 0.45})`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(pk.x - 4, pk.y);
      ctx.lineTo(pk.x + 4, pk.y);
      ctx.moveTo(pk.x, pk.y - 4);
      ctx.lineTo(pk.x, pk.y + 4);
      ctx.stroke();
      ctx.fillStyle = dark ? `hsla(172, 45%, 78%, ${a})` : `hsla(172, 55%, 25%, ${a})`;
      ctx.fillText(v.toFixed(2), pk.x, pk.y - 9);
    }
  }

  /* ---------------- the islands ---------------- */
  interface PNode {
    isl: Island;
    parents: PNode[];
    children: number;
    ax: number; ay: number;
    x: number; y: number;
    t: number;
    score: number;
    outcome: 'root' | 'better' | 'worse' | 'fail';
    alpha: number;
    removing: boolean;
    born: number;
    phase: number;
    flash: number;
  }
  interface Island {
    nodes: PNode[];
    hue: number;
    homeX: number;
    homeY: number;
    nextSample: number;
  }

  let islands: Island[] = [];
  let frame = 0;
  let expedition = 1;
  let retiring = 0;

  function makeNode(isl: Island, parents: PNode[], score: number, outcome: PNode['outcome'], ax: number, ay: number): PNode {
    const px = parents.length ? parents.reduce((s, p) => s + p.x, 0) / parents.length : ax;
    const py = parents.length ? parents.reduce((s, p) => s + p.y, 0) / parents.length : ay;
    return {
      isl, parents, children: 0,
      ax, ay, x: px, y: py,
      t: parents.length && !reduceMotion ? 0 : 1,
      score, outcome,
      alpha: 0, removing: false,
      born: frame,
      phase: Math.random() * Math.PI * 2,
      flash: 0,
    };
  }

  function sampleParents(isl: Island, k: number): PNode[] {
    const pool = isl.nodes.filter((n) => !n.removing && n.outcome !== 'fail' && n.t >= 1);
    const out: PNode[] = [];
    for (let s = 0; s < k && pool.length; s++) {
      const weights = pool.map((n) => Math.exp(n.score * 6 - (frame - n.born) * RECENCY));
      let r = Math.random() * weights.reduce((a, b) => a + b, 0);
      let pick = pool.length - 1;
      for (let i = 0; i < pool.length; i++) {
        r -= weights[i];
        if (r <= 0) { pick = i; break; }
      }
      out.push(pool[pick]);
      pool.splice(pick, 1);
    }
    return out;
  }

  /** Candidate placement: greedy over a handful of proposals — the lineage
   *  visibly climbs toward whatever high ground is nearby. */
  function childAnchor(parents: PNode[]): [number, number, number] | null {
    const px = parents.reduce((s, p) => s + p.ax, 0) / parents.length;
    const py = parents.reduce((s, p) => s + p.ay, 0) / parents.length;
    let best: [number, number, number] | null = null;
    for (let c = 0; c < 6; c++) {
      const dir = Math.random() * Math.PI * 2;
      const d = STEP();
      const ax = px + Math.cos(dir) * d;
      const ay = py + Math.sin(dir) * d;
      const f = fitness(ax, ay);
      if (!best || f > best[2]) best = [ax, ay, f];
    }
    return best && best[2] > 0.015 ? best : null;
  }

  function generateChildren(isl: Island, parents: PNode[]) {
    const n = 2 + Math.floor(Math.random() * 2); // 2–3 programs per prompt
    const pScore = Math.max(...parents.map((p) => p.score));
    for (let k = 0; k < n; k++) {
      const spot = childAnchor(parents);
      if (!spot || Math.random() < FAIL_P) {
        const p0 = parents[0];
        const a = Math.random() * Math.PI * 2;
        isl.nodes.push(makeNode(isl, parents, 0, 'fail', p0.ax + Math.cos(a) * 14, p0.ay + Math.sin(a) * 14));
      } else {
        const score = Math.min(1, Math.max(0.02, spot[2] * 0.85 + (Math.random() - 0.35) * 0.12));
        isl.nodes.push(makeNode(isl, parents, score, score > pScore ? 'better' : 'worse', spot[0], spot[1]));
      }
      for (const p of parents) p.children++;
    }
    for (const p of parents) p.flash = 1;
  }

  /** Spawn islands a short hike from the score clusters, so each one has
   *  somewhere obvious to evolve toward. */
  function spawnIslands() {
    islands = [];
    // pick N peaks evenly down the page as island "destinations"
    const sorted = [...peaks].sort((a, b) => a.y - b.y);
    const chosen: Peak[] = [];
    const stride = Math.max(1, Math.floor(sorted.length / N_ISLANDS));
    for (let i = 0; i < sorted.length && chosen.length < N_ISLANDS; i += stride) chosen.push(sorted[i]);

    chosen.forEach((pk, i) => {
      // home: offset from the peak, in open ground
      let hx = pk.x, hy = pk.y;
      for (let c = 0; c < 12; c++) {
        const a = Math.random() * Math.PI * 2;
        const d = pk.sigma * (HOME_DIST + Math.random() * 0.5);
        const x = Math.max(30, Math.min(w - 30, pk.x + Math.cos(a) * d));
        const y = Math.max(30, Math.min(h - 30, pk.y + Math.sin(a) * d));
        if (!insideBlock(x, y)) { hx = x; hy = y; break; }
      }
      const isl: Island = {
        nodes: [],
        hue: HUES[i % HUES.length],
        homeX: hx,
        homeY: hy,
        nextSample: frame + 20 + i * 14,
      };
      const root = makeNode(isl, [], 0.25, 'root', hx, hy);
      root.t = 1;
      isl.nodes.push(root);
      generateChildren(isl, [root]);
      islands.push(isl);
    });
  }

  collect();
  generatePeaks();
  spawnIslands();
  let terrainH = h;
  function remeasure() {
    resize();
    collect();
    if (Math.abs(h - terrainH) > h * 0.15) {
      terrainH = h;
      generatePeaks();
    }
  }
  window.addEventListener('load', remeasure);
  new ResizeObserver(remeasure).observe(field);
  setInterval(collect, 2500);

  function champion(): PNode | null {
    let best: PNode | null = null;
    for (const isl of islands)
      for (const n of isl.nodes)
        if (!n.removing && n.outcome !== 'fail' && (!best || n.score > best.score)) best = n;
    return best;
  }

  const ease = (t: number) => 1 - Math.pow(1 - t, 3);

  function tick() {
    frame++;
    ctx.clearRect(0, 0, w, h);
    const dark = isDark();
    const fr = canvas.getBoundingClientRect();
    const viewTop = -fr.top - 400;
    const viewBot = -fr.top + window.innerHeight + 400;

    if (frame === 1 || frame % 45 === 0) drawHeatmap();
    drawLandscape(dark);

    /* ---- expedition lifecycle: retire when the terrain is spent ---- */
    const exhausted = peaks.length > 0 && peaks.every((p) => p.energy < 0.2);
    if (!retiring && exhausted) retiring = 240;
    if (retiring > 0) {
      retiring--;
      if (retiring === 120) for (const isl of islands) for (const n of isl.nodes) n.removing = true;
      if (retiring === 0) {
        expedition++;
        generatePeaks();
        spawnIslands();
      }
    }

    /* ---- sampling beats (islands near the viewport only) ---- */
    if (!reduceMotion && !retiring) {
      for (const isl of islands) {
        if (isl.homeY < viewTop - 600 || isl.homeY > viewBot + 600) continue;
        if (frame < isl.nextSample) continue;
        const parents = sampleParents(isl, Math.random() < CROSS_P ? 2 : 1);
        if (parents.length) generateChildren(isl, parents);
        const near = mouse && (mouse.x - isl.homeX) ** 2 + (mouse.y - isl.homeY) ** 2 < 300 * 300;
        isl.nextSample = frame + (near ? SAMPLE_EVERY / 2.5 : SAMPLE_EVERY) * (0.7 + Math.random() * 0.6);
      }
    }

    /* ---- peak depletion ---- */
    if (frame % 30 === 0 && !retiring) {
      for (const pk of peaks) {
        let occ = 0;
        for (const isl of islands)
          for (const n of isl.nodes)
            if (!n.removing && n.outcome !== 'fail' && (n.ax - pk.x) ** 2 + (n.ay - pk.y) ** 2 < pk.sigma * pk.sigma) occ++;
        if (occ > 0) pk.energy = Math.max(0, pk.energy - occ * DEPLETE);
      }
    }

    /* ---- prune + node updates, per island ---- */
    for (const isl of islands) {
      const liveCount = isl.nodes.filter((n) => !n.removing).length;
      if (liveCount > ISLAND_CAP || (frame % PRUNE_EVERY === 0 && liveCount > 12)) {
        const leaves = isl.nodes
          .filter((n) => !n.removing && n.children === 0 && n.outcome !== 'root')
          .sort((a, b) => a.score - b.score);
        const cut = liveCount > ISLAND_CAP ? Math.max(4, liveCount - ISLAND_CAP) : Math.max(2, Math.floor(leaves.length * 0.1));
        for (const n of leaves.slice(0, cut)) n.removing = true;
      }
      for (const n of isl.nodes) {
        const onScreen = n.ay > viewTop && n.ay < viewBot;
        if (!onScreen && n.t >= 1 && !n.removing && n.flash <= 0) continue;
        if (n.t < 1) n.t = Math.min(1, n.t + 1 / GROW_FRAMES);
        const te = ease(n.t);
        const living = n.parents.filter((p) => p.alpha > 0);
        const px = living.length ? living.reduce((s, p) => s + p.x, 0) / living.length : n.ax;
        const py = living.length ? living.reduce((s, p) => s + p.y, 0) / living.length : n.ay;
        const bx = reduceMotion ? 0 : Math.sin(frame * 0.008 + n.phase) * 2;
        const by = reduceMotion ? 0 : Math.cos(frame * 0.009 + n.phase) * 2;
        n.x = px + (n.ax + bx - px) * te;
        n.y = py + (n.ay + by - py) * te;
        if (n.outcome === 'fail' && frame - n.born > FAIL_TTL) n.removing = true;
        if (n.removing) n.alpha = Math.max(0, n.alpha - 0.02);
        else n.alpha = Math.min(n.outcome === 'fail' ? 0.5 : 1, n.alpha + 0.035);
        if (n.flash > 0) n.flash -= 0.025;
      }
      for (let i = isl.nodes.length - 1; i >= 0; i--) {
        const n = isl.nodes[i];
        if (n.removing && n.alpha <= 0) {
          for (const p of n.parents) p.children--;
          isl.nodes.splice(i, 1);
        }
      }
    }

    const champ = champion();

    /* ---- draw lineage edges (within islands only) ---- */
    for (const isl of islands) {
      for (const n of isl.nodes) {
        for (const p of n.parents) {
          const a = Math.min(n.alpha, p.alpha);
          if (a <= 0) continue;
          let stroke: string;
          let lw = 0.8;
          if (n.outcome === 'better') {
            stroke = dark ? `hsla(${isl.hue}, 70%, 70%, ${0.45 * a})` : `hsla(${isl.hue}, 65%, 32%, ${0.4 * a})`;
            lw = 1.1;
          } else if (n.outcome === 'worse') {
            stroke = dark ? `hsla(40, 45%, 60%, ${0.25 * a})` : `hsla(38, 50%, 40%, ${0.22 * a})`;
          } else {
            stroke = dark ? `hsla(5, 65%, 58%, ${0.28 * a})` : `hsla(4, 70%, 42%, ${0.25 * a})`;
          }
          ctx.strokeStyle = stroke;
          ctx.lineWidth = lw;
          ctx.beginPath();
          ctx.moveTo(p.x, p.y);
          ctx.lineTo(n.x, n.y);
          ctx.stroke();
        }
      }
    }

    /* ---- draw nodes ---- */
    for (const isl of islands) {
      for (const n of isl.nodes) {
        if (n.alpha <= 0) continue;
        let fill: string;
        const r = 1.6 + n.score * 3;
        if (n.outcome === 'fail') {
          fill = dark ? `hsla(5, 70%, 55%, ${0.45 * n.alpha})` : `hsla(4, 75%, 45%, ${0.4 * n.alpha})`;
        } else if (n.outcome === 'worse') {
          fill = dark ? `hsla(40, 40%, 58%, ${0.5 * n.alpha})` : `hsla(38, 45%, 45%, ${0.45 * n.alpha})`;
        } else {
          const l = dark ? 55 + n.score * 32 : 45 - n.score * 18;
          fill = `hsla(${isl.hue}, 65%, ${l}%, ${(0.45 + n.score * 0.5) * n.alpha})`;
        }
        ctx.fillStyle = fill;
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.outcome === 'fail' ? 1.5 : r, 0, Math.PI * 2);
        ctx.fill();

        if (n.flash > 0) {
          ctx.strokeStyle = dark ? `hsla(${isl.hue}, 80%, 78%, ${n.flash * 0.6})` : `hsla(${isl.hue}, 70%, 35%, ${n.flash * 0.5})`;
          ctx.lineWidth = 1.1;
          ctx.beginPath();
          ctx.arc(n.x, n.y, r + 4 + (1 - n.flash) * 7, 0, Math.PI * 2);
          ctx.stroke();
        }
      }
    }

    /* ---- champion halo ---- */
    if (champ) {
      const halo = 6 + Math.sin(frame * 0.06) * 1.5;
      ctx.strokeStyle = dark ? 'hsla(50, 90%, 72%, 0.75)' : 'hsla(45, 95%, 38%, 0.7)';
      ctx.lineWidth = 1.3;
      ctx.beginPath();
      ctx.arc(champ.x, champ.y, halo, 0, Math.PI * 2);
      ctx.stroke();
    }

    if (frame % 20 === 0) {
      statsEl.textContent = `expedition ${expedition} · best ${(champ?.score ?? 0).toFixed(3)}`;
    }
    requestAnimationFrame(tick);
  }
  tick();
</script>
