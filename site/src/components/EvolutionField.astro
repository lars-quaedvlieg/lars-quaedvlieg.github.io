---
// Full-page generative layer: ONE evolutionary search expedition over the
// page-as-score-landscape.
//
//   · the page IS the fitness surface, and you can see it: a procedural
//     terrain of peaks (soft contour glows) scattered through the whitespace
//   · content is SACRED ground — zero score, never overgrown; the lineages
//     wrap around the text on their way past
//   · the expedition starts at the short description up top and is guided
//     DOWNWARD by the terrain — programs are scored by the ground they land
//     on, high-scoring lineages get sampled more, so the frontier climbs
//     from peak to peak toward the bottom of the page
//   · peaks DEPLETE as the population feeds on them (their glow dims), so
//     the search keeps moving; when the frontier reaches the bottom the
//     expedition retires and a new one sets out over a NEW random terrain
---

<div id="evo-field" class="pointer-events-none absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
  <canvas id="evo-canvas" class="absolute inset-0 h-full w-full"></canvas>
</div>
<p
  id="evo-stats"
  class="pointer-events-none fixed right-3 bottom-2 z-20 font-mono text-[10px] tracking-widest text-ink-400/70 uppercase select-none dark:text-ink-500/70"
  aria-hidden="true"
>
  expedition 1 · best 0.000
</p>

<script>
  const field = document.getElementById('evo-field')!;
  const canvas = document.getElementById('evo-canvas') as HTMLCanvasElement;
  const statsEl = document.getElementById('evo-stats')!;
  const ctx = canvas.getContext('2d')!;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mobile = window.innerWidth < 640;

  /* ----------------------- tuning ----------------------- */
  const POP_CAP = mobile ? 46 : 80;     // living nodes before pruning
  const SAMPLE_EVERY = mobile ? 34 : 22; // frames between sampling beats
  const GROW_FRAMES = 22;
  const FAIL_P = 0.1;
  const FAIL_TTL = 320;
  const PRUNE_EVERY = 200;
  const CROSS_P = 0.4;        // chance a beat samples TWO parents
  const PAD = 16;             // sacred margin around content blocks
  const DOWN_BIAS = 0.45;     // how strongly candidates prefer heading down-page
  const RECENCY = 0.0009;     // sampling decay per frame of age (frontier advances)
  const DEPLETE = 0.0035;     // peak energy drain per occupant per check
  const STEP = () => (mobile ? 32 : 42) + Math.random() * 26;
  const HUE = 172;            // population color family

  let w = 0, h = 0, dpr = 1;
  function resize() {
    w = field.clientWidth;
    h = field.clientHeight;
    dpr = Math.min(window.devicePixelRatio || 1, 1.75, Math.sqrt(26e6 / Math.max(1, w * h)));
    canvas.width = Math.floor(w * dpr);
    canvas.height = Math.floor(h * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  resize();

  /* ---------------- landscape ---------------- */
  interface Rect { x: number; y: number; w: number; h: number }
  interface Peak { x: number; y: number; amp: number; sigma: number; energy: number }
  let blocks: Rect[] = [];
  let peaks: Peak[] = [];
  let startAt = { x: 0, y: 0 };

  function collect() {
    const fr = field.getBoundingClientRect();
    blocks = [...document.querySelectorAll('[data-evo-block]')].map((el) => {
      const r = el.getBoundingClientRect();
      return { x: r.left - fr.left - PAD, y: r.top - fr.top - PAD, w: r.width + PAD * 2, h: r.height + PAD * 2 };
    });
    const start = document.querySelector('[data-evo-start]');
    if (start) {
      const r = start.getBoundingClientRect();
      // Desktop: set out from the whitespace right of the description.
      // Mobile: from just underneath it.
      startAt = mobile
        ? { x: r.left - fr.left + r.width * 0.5, y: r.bottom - fr.top + 70 }
        : { x: Math.min(w - 60, r.right - fr.left + 110), y: r.top - fr.top + r.height * 0.45 };
    }
  }

  function insideBlock(x: number, y: number): boolean {
    for (const b of blocks) {
      if (x > b.x && x < b.x + b.w && y > b.y && y < b.y + b.h) return true;
    }
    return false;
  }

  /** Procedural terrain: random peaks in the whitespace between the content. */
  function generatePeaks() {
    peaks = [];
    const K = Math.max(4, Math.min(10, Math.round(h / 550)));
    for (let k = 0; k < K; k++) {
      const bandY = ((k + 0.3 + Math.random() * 0.4) / K) * h;
      let best: Peak | null = null;
      let bestD = -1;
      for (let c = 0; c < 24; c++) {
        const x = 40 + Math.random() * (w - 80);
        const y = Math.max(60, Math.min(h - 60, bandY + (Math.random() - 0.5) * 220));
        if (insideBlock(x, y)) continue;
        const dPeaks = peaks.length ? Math.min(...peaks.map((p) => Math.hypot(p.x - x, p.y - y))) : 9999;
        if (dPeaks > bestD) {
          bestD = dPeaks;
          best = { x, y, amp: 0.55 + Math.random() * 0.45, sigma: 130 + Math.random() * 90, energy: 1 };
        }
      }
      if (best) peaks.push(best);
    }
  }

  collect();
  generatePeaks();
  let terrainH = h;
  function remeasure() {
    resize();
    collect();
    // Only regrow the terrain when the page itself changed shape.
    if (Math.abs(h - terrainH) > h * 0.15) {
      terrainH = h;
      generatePeaks();
    }
  }
  window.addEventListener('load', remeasure);
  new ResizeObserver(remeasure).observe(field);
  setInterval(collect, 2500);

  let mouse: { x: number; y: number } | null = null;
  window.addEventListener('pointermove', (e) => {
    const fr = field.getBoundingClientRect();
    mouse = { x: e.clientX - fr.left, y: e.clientY - fr.top };
  });

  function fitness(x: number, y: number): number {
    if (x < 14 || y < 14 || x > w - 14 || y > h - 14) return 0;
    if (insideBlock(x, y)) return 0; // sacred ground
    let f = 0.06;
    for (const pk of peaks) {
      const d2 = (x - pk.x) ** 2 + (y - pk.y) ** 2;
      if (d2 < pk.sigma * pk.sigma * 9) f += pk.amp * pk.energy * Math.exp(-d2 / (2 * pk.sigma * pk.sigma));
    }
    if (mouse) {
      const d2 = (x - mouse.x) ** 2 + (y - mouse.y) ** 2;
      f += 0.4 * Math.exp(-d2 / (2 * 150 * 150));
    }
    return Math.min(1, f);
  }

  /* ---------------- the expedition ---------------- */
  interface PNode {
    parents: PNode[];
    children: number;
    ax: number; ay: number;
    x: number; y: number;
    t: number;
    score: number;
    outcome: 'root' | 'better' | 'worse' | 'fail';
    alpha: number;
    removing: boolean;
    born: number;
    phase: number;
    flash: number;
  }

  let nodes: PNode[] = [];
  let frame = 0;
  let expedition = 1;
  let nextSample = 30;
  let retiring = 0; // frames until the next expedition sets out

  function makeNode(parents: PNode[], score: number, outcome: PNode['outcome'], ax: number, ay: number): PNode {
    const px = parents.length ? parents.reduce((s, p) => s + p.x, 0) / parents.length : ax;
    const py = parents.length ? parents.reduce((s, p) => s + p.y, 0) / parents.length : ay;
    return {
      parents, children: 0,
      ax, ay, x: px, y: py,
      t: parents.length && !reduceMotion ? 0 : 1,
      score, outcome,
      alpha: 0, removing: false,
      born: frame,
      phase: Math.random() * Math.PI * 2,
      flash: 0,
    };
  }

  /** Fitness-proportionate AND recency-weighted: the frontier keeps moving. */
  function sampleParents(k: number): PNode[] {
    const pool = nodes.filter((n) => !n.removing && n.outcome !== 'fail' && n.t >= 1);
    const out: PNode[] = [];
    for (let s = 0; s < k && pool.length; s++) {
      const weights = pool.map((n) => Math.exp(n.score * 6 - (frame - n.born) * RECENCY));
      let r = Math.random() * weights.reduce((a, b) => a + b, 0);
      let pick = pool.length - 1;
      for (let i = 0; i < pool.length; i++) {
        r -= weights[i];
        if (r <= 0) { pick = i; break; }
      }
      out.push(pool[pick]);
      pool.splice(pick, 1);
    }
    return out;
  }

  /** Candidate placement: prefer high ground, gently prefer down-page. */
  function childAnchor(parents: PNode[]): [number, number, number] | null {
    const px = parents.reduce((s, p) => s + p.ax, 0) / parents.length;
    const py = parents.reduce((s, p) => s + p.ay, 0) / parents.length;
    let best: [number, number, number] | null = null;
    let bestV = -1;
    for (let c = 0; c < 5; c++) {
      const dir = Math.random() * Math.PI * 2;
      const d = STEP();
      const ax = px + Math.cos(dir) * d;
      const ay = py + Math.sin(dir) * d;
      const f = fitness(ax, ay);
      const v = f * (1 + DOWN_BIAS * Math.sin(dir)); // sin>0 = downward
      if (v > bestV) { bestV = v; best = [ax, ay, f]; }
    }
    return best && best[2] > 0.015 ? best : null;
  }

  function generateChildren(parents: PNode[]) {
    const n = 1 + Math.floor(Math.random() * 2); // 1–2 programs per prompt
    const pScore = Math.max(...parents.map((p) => p.score));
    for (let k = 0; k < n; k++) {
      const spot = childAnchor(parents);
      if (!spot || Math.random() < FAIL_P) {
        const p0 = parents[0];
        const a = Math.random() * Math.PI * 2;
        nodes.push(makeNode(parents, 0, 'fail', p0.ax + Math.cos(a) * 14, p0.ay + Math.sin(a) * 14));
      } else {
        const score = Math.min(1, Math.max(0.02, spot[2] * 0.85 + (Math.random() - 0.35) * 0.12));
        nodes.push(makeNode(parents, score, score > pScore ? 'better' : 'worse', spot[0], spot[1]));
      }
      for (const p of parents) p.children++;
    }
    for (const p of parents) p.flash = 1;
  }

  function launchExpedition() {
    const root = makeNode([], 0.3, 'root', startAt.x, startAt.y);
    root.t = 1;
    nodes.push(root);
    for (let i = 0; i < 2; i++) generateChildren([root]);
    generatePeaks(); // every expedition explores fresh terrain
  }
  launchExpedition();

  function champion(): PNode | null {
    let best: PNode | null = null;
    for (const n of nodes)
      if (!n.removing && n.outcome !== 'fail' && (!best || n.score > best.score)) best = n;
    return best;
  }

  const isDark = () => document.documentElement.classList.contains('dark');
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);

  function drawLandscape(dark: boolean) {
    for (const pk of peaks) {
      const a = (0.5 + pk.amp * 0.5) * (0.25 + pk.energy * 0.75);
      // soft summit glow
      const g = ctx.createRadialGradient(pk.x, pk.y, 0, pk.x, pk.y, pk.sigma * 1.7);
      g.addColorStop(0, dark ? `hsla(${HUE}, 60%, 60%, ${0.07 * a})` : `hsla(${HUE}, 65%, 40%, ${0.06 * a})`);
      g.addColorStop(1, 'transparent');
      ctx.fillStyle = g;
      ctx.fillRect(pk.x - pk.sigma * 1.7, pk.y - pk.sigma * 1.7, pk.sigma * 3.4, pk.sigma * 3.4);
      // contour rings make it read as topography
      const rings = mobile ? 2 : 3;
      for (let i = 1; i <= rings; i++) {
        ctx.strokeStyle = dark ? `hsla(${HUE}, 50%, 65%, ${0.05 * a})` : `hsla(${HUE}, 55%, 35%, ${0.05 * a})`;
        ctx.lineWidth = 0.8;
        ctx.beginPath();
        ctx.arc(pk.x, pk.y, pk.sigma * (0.45 + i * 0.4), 0, Math.PI * 2);
        ctx.stroke();
      }
    }
  }

  function tick() {
    frame++;
    ctx.clearRect(0, 0, w, h);
    const dark = isDark();
    const fr = canvas.getBoundingClientRect();
    const viewTop = -fr.top - 400;
    const viewBot = -fr.top + window.innerHeight + 400;

    drawLandscape(dark);

    /* ---- expedition lifecycle ---- */
    const frontier = Math.max(0, ...nodes.filter((n) => !n.removing && n.outcome !== 'fail').map((n) => n.ay));
    const exhausted = peaks.length > 0 && peaks.every((p) => p.energy < 0.2);
    if (!retiring && (frontier > h - 220 || exhausted)) retiring = 240;
    if (retiring > 0) {
      retiring--;
      if (retiring === 120) for (const n of nodes) n.removing = true;
      if (retiring === 0) {
        expedition++;
        launchExpedition();
      }
    }

    /* ---- sampling beat (single population) ---- */
    if (!reduceMotion && !retiring && frame >= nextSample) {
      const parents = sampleParents(Math.random() < CROSS_P ? 2 : 1);
      if (parents.length) generateChildren(parents);
      // a cursor hovering near the frontier turns up the tempo
      const ch = champion();
      const near = mouse && ch && (mouse.x - ch.x) ** 2 + (mouse.y - ch.y) ** 2 < 300 * 300;
      nextSample = frame + (near ? SAMPLE_EVERY / 2.5 : SAMPLE_EVERY) * (0.7 + Math.random() * 0.6);
    }

    /* ---- peak depletion: the search consumes what it finds ---- */
    if (frame % 30 === 0 && !retiring) {
      for (const pk of peaks) {
        let occ = 0;
        for (const n of nodes) {
          if (!n.removing && n.outcome !== 'fail' && (n.ax - pk.x) ** 2 + (n.ay - pk.y) ** 2 < pk.sigma * pk.sigma) occ++;
        }
        if (occ > 0) pk.energy = Math.max(0, pk.energy - occ * DEPLETE);
      }
    }

    /* ---- prune ---- */
    const liveCount = nodes.filter((n) => !n.removing).length;
    if (liveCount > POP_CAP || (frame % PRUNE_EVERY === 0 && liveCount > 14)) {
      const leaves = nodes
        .filter((n) => !n.removing && n.children === 0 && n.outcome !== 'root')
        .sort((a, b) => a.score - b.score);
      const cut = liveCount > POP_CAP ? Math.max(6, liveCount - POP_CAP) : Math.max(2, Math.floor(leaves.length * 0.15));
      for (const n of leaves.slice(0, cut)) n.removing = true;
    }

    /* ---- node updates ---- */
    for (const n of nodes) {
      const onScreen = n.ay > viewTop && n.ay < viewBot;
      if (!onScreen && n.t >= 1 && !n.removing && n.flash <= 0) continue;
      if (n.t < 1) n.t = Math.min(1, n.t + 1 / GROW_FRAMES);
      const te = ease(n.t);
      const living = n.parents.filter((p) => p.alpha > 0);
      const px = living.length ? living.reduce((s, p) => s + p.x, 0) / living.length : n.ax;
      const py = living.length ? living.reduce((s, p) => s + p.y, 0) / living.length : n.ay;
      const bx = reduceMotion ? 0 : Math.sin(frame * 0.008 + n.phase) * 2;
      const by = reduceMotion ? 0 : Math.cos(frame * 0.009 + n.phase) * 2;
      n.x = px + (n.ax + bx - px) * te;
      n.y = py + (n.ay + by - py) * te;
      if (n.outcome === 'fail' && frame - n.born > FAIL_TTL) n.removing = true;
      if (n.removing) n.alpha = Math.max(0, n.alpha - 0.02);
      else n.alpha = Math.min(n.outcome === 'fail' ? 0.5 : 1, n.alpha + 0.035);
      if (n.flash > 0) n.flash -= 0.025;
    }
    for (let i = nodes.length - 1; i >= 0; i--) {
      const n = nodes[i];
      if (n.removing && n.alpha <= 0) {
        for (const p of n.parents) p.children--;
        nodes.splice(i, 1);
      }
    }

    const champ = champion();

    /* ---- draw lineage edges ---- */
    for (const n of nodes) {
      for (const p of n.parents) {
        const a = Math.min(n.alpha, p.alpha);
        if (a <= 0) continue;
        let stroke: string;
        let lw = 0.8;
        if (n.outcome === 'better') {
          stroke = dark ? `hsla(${HUE}, 70%, 70%, ${0.45 * a})` : `hsla(${HUE}, 65%, 32%, ${0.4 * a})`;
          lw = 1.1;
        } else if (n.outcome === 'worse') {
          stroke = dark ? `hsla(40, 45%, 60%, ${0.25 * a})` : `hsla(38, 50%, 40%, ${0.22 * a})`;
        } else {
          stroke = dark ? `hsla(5, 65%, 58%, ${0.28 * a})` : `hsla(4, 70%, 42%, ${0.25 * a})`;
        }
        ctx.strokeStyle = stroke;
        ctx.lineWidth = lw;
        ctx.beginPath();
        ctx.moveTo(p.x, p.y);
        ctx.lineTo(n.x, n.y);
        ctx.stroke();
      }
    }

    /* ---- draw nodes ---- */
    for (const n of nodes) {
      if (n.alpha <= 0) continue;
      let fill: string;
      const r = 1.6 + n.score * 3;
      if (n.outcome === 'fail') {
        fill = dark ? `hsla(5, 70%, 55%, ${0.45 * n.alpha})` : `hsla(4, 75%, 45%, ${0.4 * n.alpha})`;
      } else if (n.outcome === 'worse') {
        fill = dark ? `hsla(40, 40%, 58%, ${0.5 * n.alpha})` : `hsla(38, 45%, 45%, ${0.45 * n.alpha})`;
      } else {
        const l = dark ? 55 + n.score * 32 : 45 - n.score * 18;
        fill = `hsla(${HUE}, 65%, ${l}%, ${(0.45 + n.score * 0.5) * n.alpha})`;
      }
      ctx.fillStyle = fill;
      ctx.beginPath();
      ctx.arc(n.x, n.y, n.outcome === 'fail' ? 1.5 : r, 0, Math.PI * 2);
      ctx.fill();

      if (n.flash > 0) {
        ctx.strokeStyle = dark ? `hsla(${HUE}, 80%, 78%, ${n.flash * 0.6})` : `hsla(${HUE}, 70%, 35%, ${n.flash * 0.5})`;
        ctx.lineWidth = 1.1;
        ctx.beginPath();
        ctx.arc(n.x, n.y, r + 4 + (1 - n.flash) * 7, 0, Math.PI * 2);
        ctx.stroke();
      }
    }

    /* ---- champion halo ---- */
    if (champ) {
      const halo = 6 + Math.sin(frame * 0.06) * 1.5;
      ctx.strokeStyle = dark ? 'hsla(50, 90%, 72%, 0.75)' : 'hsla(45, 95%, 38%, 0.7)';
      ctx.lineWidth = 1.3;
      ctx.beginPath();
      ctx.arc(champ.x, champ.y, halo, 0, Math.PI * 2);
      ctx.stroke();
    }

    if (frame % 20 === 0) {
      statsEl.textContent = `expedition ${expedition} · best ${(champ?.score ?? 0).toFixed(3)}`;
    }
    requestAnimationFrame(tick);
  }
  tick();
</script>
