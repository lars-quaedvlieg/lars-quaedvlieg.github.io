---
// Full-page generative layer: evolutionary search over the page-as-score-landscape.
//
// DYNAMICS (deliberately modeled as real search runs):
//   · terrain: one owned peak per run + a few low decoy bumps, all placed
//     with clearance from text and edges; content blocks are SACRED (zero
//     score, never overgrown). The surface renders as a quantized heatmap
//     with numeric summit scores. Scores never decay.
//   · each RUN spawns far from its target (2.5–3.5σ) and carries a weak
//     directional prior toward it — across flat ground the prior guides,
//     near the peak the real score gradient takes over
//   · runs are independent: no interbreeding, no shared edges. Within a run,
//     a child can have two parents (lineage DAG). bright = improved,
//     amber = worse, red = failed program
//   · a run CONVERGES when its champion sits on the summit with a near-max
//     score, or when it stagnates (a local optimum). The graph then FREEZES
//     as a finished artifact — slightly dimmed, champion crowned, fail stubs
//     cleaned up. The run is over; nothing decays.
//   · renewal is staggered: once all runs are frozen, the oldest artifact
//     occasionally fades out, its peak regrows elsewhere, and a fresh run
//     sets out — the page stays mostly calm with one or two live searches.
---

<div id="evo-field" class="pointer-events-none absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
  <canvas id="evo-canvas" class="absolute inset-0 h-full w-full"></canvas>
</div>
<button
  id="evo-stats"
  type="button"
  class="fixed right-3 bottom-2 z-20 cursor-help font-mono text-[10px] tracking-widest text-ink-400/70 uppercase select-none hover:text-accent-600 dark:text-ink-500/70 dark:hover:text-accent-400"
  aria-expanded="false"
  aria-controls="evo-about"
>
  runs 0 · solved 0
</button>
<aside
  id="evo-about"
  hidden
  class="fixed right-3 bottom-8 z-20 w-72 rounded-xl border border-ink-200 bg-white/95 p-4 text-xs leading-relaxed text-ink-600 shadow-lg backdrop-blur dark:border-ink-800 dark:bg-ink-950/95 dark:text-ink-300"
>
  <p class="font-mono text-[10px] tracking-widest text-accent-700 uppercase dark:text-accent-400">you found the search</p>
  <p class="mt-2">
    This page is a fitness landscape, and what's crawling over it is <em>evolutionary search</em> — the thing I research.
    Each colored lineage is an independent run: it samples parents (better programs reproduce more), and an LLM-style
    operator proposes children, scored by the ground they land on.
  </p>
  <ul class="mt-2 space-y-1">
    <li><span class="mr-1 inline-block h-2 w-2 rounded-full bg-teal-500"></span> improved on its parent</li>
    <li><span class="mr-1 inline-block h-2 w-2 rounded-full bg-amber-500"></span> worse than its parent</li>
    <li><span class="mr-1 inline-block h-2 w-2 rounded-full bg-red-500"></span> failed to run at all</li>
    <li><span class="mr-1 inline-block h-2 w-2 rounded-full border border-yellow-500"></span> champion of its run</li>
  </ul>
  <p class="mt-2">
    Runs converge on a summit — or stagnate on a local optimum — then freeze as artifacts. Your text is sacred ground;
    your cursor is a fitness peak. Try luring a run somewhere.
  </p>
</aside>

<script>
  const field = document.getElementById('evo-field')!;
  const canvas = document.getElementById('evo-canvas') as HTMLCanvasElement;
  const statsEl = document.getElementById('evo-stats')!;
  const aboutEl = document.getElementById('evo-about')!;
  statsEl.addEventListener('click', () => {
    aboutEl.hidden = !aboutEl.hidden;
    statsEl.setAttribute('aria-expanded', String(!aboutEl.hidden));
  });
  console.log(
    '%cYou found the search.%c\n' +
      'This site runs island-model evolutionary search over the page as a fitness landscape.\n' +
      'Text is sacred ground. Your cursor is a fitness peak. The counter bottom-right explains the rest.',
    'color:#0d9488;font-weight:bold;font-size:14px',
    'color:inherit'
  );
  const ctx = canvas.getContext('2d')!;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mobile = window.innerWidth < 640;

  /* ----------------------- tuning ----------------------- */
  // run/terrain density scales with page height (set after first resize)
  let N_RUNS = 5;
  let N_HILLS = 28;
  let N_ROLLERS = 8;
  const RUN_CAP = mobile ? 30 : 44;      // living nodes per run
  const SAMPLE_EVERY = mobile ? 24 : 14; // frames between beats, per run
  const GROW_FRAMES = 22;
  const FAIL_P = 0.1;
  const FAIL_TTL = 320;
  const CROSS_P = 0.4;                   // two-parent beats (within a run)
  const PAD = 16;                        // sacred margin around content
  const RECENCY = 0.0006;                // frontier keeps moving
  const SPAWN_MIN = 2.5, SPAWN_MAX = 3.5; // spawn distance in units of σ
  const PRIOR = 0.5;                     // strength of the toward-target prior
  const STAGNATE_BEATS = 40;             // beats without improvement → local optimum
  const SUMMIT_FRAC = 0.78;              // champion ≥ this × peak amp → solved
  const RECYCLE_COOLDOWN = 180;          // min frames between artifact recycles
  const CLEARANCE = 0.9;                 // peak distance from text, in units of σ
  const STEP = () => (mobile ? 36 : 46) + Math.random() * 30;
  const HUES = [172, 205, 260, 140, 305, 95];
  const CELL = mobile ? 22 : 18;         // heatmap resolution (css px per cell)

  let w = 0, h = 0, dpr = 1;
  function resize() {
    w = field.clientWidth;
    h = field.clientHeight;
    dpr = Math.min(window.devicePixelRatio || 1, 1.75, Math.sqrt(26e6 / Math.max(1, w * h)));
    canvas.width = Math.floor(w * dpr);
    canvas.height = Math.floor(h * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  resize();
  N_RUNS = mobile ? Math.max(2, Math.min(6, Math.round(h / 1100))) : Math.max(3, Math.min(9, Math.round(h / 900)));
  N_HILLS = mobile ? Math.max(8, Math.min(30, Math.round(h / 220))) : Math.max(10, Math.min(42, Math.round(h / 160)));
  N_ROLLERS = Math.max(3, Math.min(10, Math.round(h / 550)));

  /* ---------------- landscape ---------------- */
  interface Rect { x: number; y: number; w: number; h: number }
  interface Peak { x: number; y: number; amp: number; sigma: number; decoy: boolean }
  let blocks: Rect[] = [];
  let peaks: Peak[] = [];

  function collect() {
    const fr = field.getBoundingClientRect();
    blocks = [...document.querySelectorAll('[data-evo-block]')].map((el) => {
      const r = el.getBoundingClientRect();
      return { x: r.left - fr.left - PAD, y: r.top - fr.top - PAD, w: r.width + PAD * 2, h: r.height + PAD * 2 };
    });
  }

  function insideBlock(x: number, y: number): boolean {
    for (const b of blocks) {
      if (x > b.x && x < b.x + b.w && y > b.y && y < b.y + b.h) return true;
    }
    return false;
  }

  /** Distance from a point to the nearest content block (0 if inside). */
  function blockDist(x: number, y: number): number {
    let d = Infinity;
    for (const b of blocks) {
      const dx = Math.max(b.x - x, 0, x - (b.x + b.w));
      const dy = Math.max(b.y - y, 0, y - (b.y + b.h));
      d = Math.min(d, Math.hypot(dx, dy));
    }
    return d;
  }

  /**
   * Place one peak inside a vertical band, far enough from text and edges
   * that its visible bands fade before touching anything.
   */
  function placePeak(y0: number, y1: number, decoy: boolean, clearanceFactor = 1): Peak | null {
    let best: Peak | null = null;
    let bestV = -1;
    for (let c = 0; c < 40; c++) {
      const sigma = decoy ? 45 + Math.random() * 80 : 130 + Math.random() * 80;
      const x = sigma * 0.6 + Math.random() * (w - sigma * 1.2);
      const y = Math.max(sigma * 0.6, Math.min(h - sigma * 0.6, y0 + Math.random() * (y1 - y0)));
      const clear = blockDist(x, y) / sigma; // in σ units
      if (clear < CLEARANCE * clearanceFactor) continue;
      const dPeaks = peaks.length ? Math.min(...peaks.map((p) => Math.hypot(p.x - x, p.y - y))) : 9999;
      const v = Math.min(clear, 2) + Math.min(dPeaks / 500, 2);
      if (v > bestV) {
        bestV = v;
        best = { x, y, amp: decoy ? 0.18 + Math.random() * 0.27 : 0.6 + Math.random() * 0.4, sigma, decoy };
      }
    }
    return best;
  }

  const BLOCK_FADE = 60; // px over which terrain tapers off around content

  /** Terrain-only score (what the heatmap shows). Never decays.
   *  Sacred content is zero, with a smooth taper around it so the surface
   *  reads as contours around a plateau, not a razor-edged hole. */
  function terrain(x: number, y: number): number {
    if (x < 14 || y < 14 || x > w - 14 || y > h - 14) return 0;
    const bd = blockDist(x, y);
    if (bd <= 0) return 0; // sacred ground
    let f = 0.06;
    for (const pk of peaks) {
      const d2 = (x - pk.x) ** 2 + (y - pk.y) ** 2;
      if (d2 < pk.sigma * pk.sigma * 9) f += pk.amp * Math.exp(-d2 / (2 * pk.sigma * pk.sigma));
    }
    if (bd < BLOCK_FADE) {
      const m = bd / BLOCK_FADE;
      f *= m * m * (3 - 2 * m); // smoothstep taper into the margins
    }
    return Math.min(1, f);
  }

  let mouse: { x: number; y: number } | null = null;
  window.addEventListener('pointermove', (e) => {
    const fr = field.getBoundingClientRect();
    mouse = { x: e.clientX - fr.left, y: e.clientY - fr.top };
  });

  /** What live runs optimize: terrain + a gentle cursor bump. */
  function fitness(x: number, y: number): number {
    let f = terrain(x, y);
    if (f > 0 && mouse) {
      const d2 = (x - mouse.x) ** 2 + (y - mouse.y) ** 2;
      f += 0.25 * Math.exp(-d2 / (2 * 150 * 150));
    }
    return Math.min(1, f);
  }

  const isDark = () => document.documentElement.classList.contains('dark');

  /* ---------------- visible score surface ---------------- */
  const heat = document.createElement('canvas');
  const hctx = heat.getContext('2d')!;
  function drawHeatmap() {
    const dark = isDark();
    // very tall pages (long blog posts) get a coarser grid to stay cheap
    const cell = CELL * (h > 10000 ? 2 : 1);
    const gw = Math.max(1, Math.ceil(w / cell));
    const gh = Math.max(1, Math.ceil(h / cell));
    heat.width = gw;
    heat.height = gh;
    const img = hctx.createImageData(gw, gh);
    const [cr, cg, cb] = dark ? [45, 212, 191] : [10, 110, 102];
    const maxA = dark ? 0.24 : 0.3;
    for (let gy = 0; gy < gh; gy++) {
      for (let gx = 0; gx < gw; gx++) {
        const f = terrain(gx * CELL + CELL / 2, gy * CELL + CELL / 2);
        const i = (gy * gw + gx) * 4;
        if (f <= 0.035) continue;
        const level = Math.ceil(Math.min(1, f) * 10) / 10;
        img.data[i] = cr;
        img.data[i + 1] = cg;
        img.data[i + 2] = cb;
        img.data[i + 3] = Math.floor(level * maxA * 255);
      }
    }
    hctx.putImageData(img, 0, 0);
  }

  function drawLandscape(dark: boolean) {
    ctx.imageSmoothingEnabled = true;
    ctx.drawImage(heat, 0, 0, heat.width, heat.height, 0, 0, w, h);
    ctx.font = '10px ui-monospace, SFMono-Regular, Menlo, monospace';
    ctx.textAlign = 'center';
    for (const pk of peaks) {
      if (pk.decoy) continue;
      const a = 0.3 + pk.amp * 0.5;
      ctx.strokeStyle = dark ? `hsla(172, 60%, 70%, ${a * 0.5})` : `hsla(172, 70%, 24%, ${a * 0.7})`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(pk.x - 4, pk.y);
      ctx.lineTo(pk.x + 4, pk.y);
      ctx.moveTo(pk.x, pk.y - 4);
      ctx.lineTo(pk.x, pk.y + 4);
      ctx.stroke();
      ctx.fillStyle = dark ? `hsla(172, 45%, 78%, ${a})` : `hsla(172, 75%, 18%, ${Math.min(1, a * 1.3)})`;
      ctx.fillText(pk.amp.toFixed(2), pk.x, pk.y - 9);
    }
  }

  /* ---------------- runs ---------------- */
  interface PNode {
    run: Run;
    parents: PNode[];
    children: number;
    ax: number; ay: number;
    x: number; y: number;
    t: number;
    score: number;
    outcome: 'root' | 'better' | 'worse' | 'fail';
    alpha: number;
    removing: boolean;
    born: number;
    phase: number;
    flash: number;
  }
  interface Run {
    nodes: PNode[];
    hue: number;
    target: Peak;
    state: 'running' | 'converged' | 'fading';
    nextSample: number;
    beats: number;
    bestScore: number;
    lastImproveBeat: number;
    convergedAt: number;
  }

  let runs: Run[] = [];
  // Runs are born lazily: a peak's run only sets out once the visitor first
  // scrolls its region into view.
  let pending: { peak: Peak; hue: number }[] = [];
  let frame = 0;
  let solvedTotal = 0;

  function makeNode(run: Run, parents: PNode[], score: number, outcome: PNode['outcome'], ax: number, ay: number): PNode {
    const px = parents.length ? parents.reduce((s, p) => s + p.x, 0) / parents.length : ax;
    const py = parents.length ? parents.reduce((s, p) => s + p.y, 0) / parents.length : ay;
    return {
      run, parents, children: 0,
      ax, ay, x: px, y: py,
      t: parents.length && !reduceMotion ? 0 : 1,
      score, outcome,
      alpha: 0, removing: false,
      born: frame,
      phase: Math.random() * Math.PI * 2,
      flash: 0,
    };
  }

  function sampleParents(run: Run, k: number): PNode[] {
    const pool = run.nodes.filter((n) => !n.removing && n.outcome !== 'fail' && n.t >= 1);
    const out: PNode[] = [];
    for (let s = 0; s < k && pool.length; s++) {
      const weights = pool.map((n) => Math.exp(n.score * 4 - (frame - n.born) * RECENCY));
      let r = Math.random() * weights.reduce((a, b) => a + b, 0);
      let pick = pool.length - 1;
      for (let i = 0; i < pool.length; i++) {
        r -= weights[i];
        if (r <= 0) { pick = i; break; }
      }
      out.push(pool[pick]);
      pool.splice(pick, 1);
    }
    return out;
  }

  /**
   * Candidate placement. Each run carries a weak prior toward its target:
   * on flat ground the prior steers the lineage; near the peak the actual
   * score gradient dominates. Exploration comes from three places:
   *   · candidates are picked STOCHASTICALLY (weighted, not argmax)
   *   · a CROWDING penalty pushes children away from existing nodes
   *   · ~15% of proposals are long-range jumps (high-variance mutations)
   */
  function childAnchor(run: Run, parents: PNode[]): [number, number, number] | null {
    const px = parents.reduce((s, p) => s + p.ax, 0) / parents.length;
    const py = parents.reduce((s, p) => s + p.ay, 0) / parents.length;
    const toTarget = Math.atan2(run.target.y - py, run.target.x - px);
    const cands: { ax: number; ay: number; f: number; v: number }[] = [];
    for (let c = 0; c < 7; c++) {
      const dir = Math.random() * Math.PI * 2;
      const d = STEP() * (Math.random() < 0.15 ? 2.4 : 1); // exploration jump
      const ax = px + Math.cos(dir) * d;
      const ay = py + Math.sin(dir) * d;
      const f = fitness(ax, ay);
      if (f <= 0.015) continue;
      let crowd = 0;
      for (const n of run.nodes) {
        if (!n.removing && (n.ax - ax) ** 2 + (n.ay - ay) ** 2 < 48 * 48) crowd++;
      }
      const v = Math.max(1e-4, (f * (1 + PRIOR * Math.cos(dir - toTarget))) / (1 + 0.7 * crowd));
      cands.push({ ax, ay, f, v });
    }
    if (!cands.length) return null;
    // weighted pick (v²): good ground usually wins, but not always
    const total = cands.reduce((s, c) => s + c.v * c.v, 0);
    let r = Math.random() * total;
    for (const c of cands) {
      r -= c.v * c.v;
      if (r <= 0) return [c.ax, c.ay, c.f];
    }
    const last = cands[cands.length - 1];
    return [last.ax, last.ay, last.f];
  }

  function generateChildren(run: Run, parents: PNode[]) {
    const n = 2 + Math.floor(Math.random() * 2); // 2–3 programs per prompt
    const pScore = Math.max(...parents.map((p) => p.score));
    for (let k = 0; k < n; k++) {
      const spot = childAnchor(run, parents);
      if (!spot || Math.random() < FAIL_P) {
        const p0 = parents[0];
        const a = Math.random() * Math.PI * 2;
        run.nodes.push(makeNode(run, parents, 0, 'fail', p0.ax + Math.cos(a) * 14, p0.ay + Math.sin(a) * 14));
      } else {
        const score = Math.min(1, Math.max(0.02, spot[2] * 0.85 + (Math.random() - 0.35) * 0.12));
        run.nodes.push(makeNode(run, parents, score, score > pScore ? 'better' : 'worse', spot[0], spot[1]));
        if (score > run.bestScore) {
          run.bestScore = score;
          run.lastImproveBeat = run.beats;
        }
      }
      for (const p of parents) p.children++;
    }
    for (const p of parents) p.flash = 1;
  }

  /** Spawn a run FAR from its target, in open ground, pointed at the climb. */
  function spawnRun(target: Peak, hue: number): Run {
    let sx = target.x, sy = target.y;
    for (let c = 0; c < 24; c++) {
      const a = Math.random() * Math.PI * 2;
      const d = target.sigma * (SPAWN_MIN + Math.random() * (SPAWN_MAX - SPAWN_MIN));
      const x = Math.max(40, Math.min(w - 40, target.x + Math.cos(a) * d));
      const y = Math.max(40, Math.min(h - 40, target.y + Math.sin(a) * d));
      if (insideBlock(x, y) || blockDist(x, y) < 30) continue;
      sx = x; sy = y;
      break;
    }
    const run: Run = {
      nodes: [],
      hue,
      target,
      state: 'running',
      nextSample: frame + 20 + Math.floor(Math.random() * 30),
      beats: 0,
      bestScore: 0,
      lastImproveBeat: 0,
      convergedAt: 0,
    };
    const root = makeNode(run, [], 0.2, 'root', sx, sy);
    root.t = 1;
    run.nodes.push(root);
    generateChildren(run, [root]);
    return run;
  }

  function runChampion(run: Run): PNode | null {
    let best: PNode | null = null;
    for (const n of run.nodes)
      if (!n.removing && n.outcome !== 'fail' && (!best || n.score > best.score)) best = n;
    return best;
  }

  /* ---------------- bootstrap ---------------- */
  collect();
  {
    const bandH = h / N_RUNS;
    for (let i = 0; i < N_RUNS; i++) {
      const pk = placePeak(i * bandH, (i + 1) * bandH, false);
      if (pk) {
        peaks.push(pk);
        pending.push({ peak: pk, hue: HUES[i % HUES.length] });
      }
    }
    // rugged middle ground: lots of local optima scattered between summits
    for (let i = 0; i < N_HILLS; i++) {
      const y0 = (i / N_HILLS) * h;
      const pk = placePeak(y0, y0 + h / N_HILLS, true, 0.75);
      if (pk) peaks.push(pk);
    }
    // broad low swells: gentle gradients everywhere, no truly flat ground
    for (let i = 0; i < N_ROLLERS; i++) {
      const y0 = (i / N_ROLLERS) * h;
      peaks.push({
        x: w * (0.15 + Math.random() * 0.7),
        y: y0 + (h / N_ROLLERS) * (0.2 + Math.random() * 0.6),
        amp: 0.1 + Math.random() * 0.06,
        sigma: 350 + Math.random() * 250,
        decoy: true,
      });
    }
  }
  let terrainH = h;
  function remeasure() {
    resize();
    collect();
    terrainH = h;
  }
  window.addEventListener('load', remeasure);
  new ResizeObserver(remeasure).observe(field);
  setInterval(collect, 2500);

  let lastRecycle = 0;
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);

  function tick() {
    frame++;
    ctx.clearRect(0, 0, w, h);
    const dark = isDark();
    const fr = canvas.getBoundingClientRect();
    const viewTop = -fr.top - 400;
    const viewBot = -fr.top + window.innerHeight + 400;

    if (frame === 1 || frame % 45 === 0) drawHeatmap();
    drawLandscape(dark);

    /* ---- lazy births: a run sets out when its region first comes into view ---- */
    for (let i = pending.length - 1; i >= 0; i--) {
      const { peak, hue } = pending[i];
      if (peak.y > viewTop + 250 && peak.y < viewBot - 100) {
        runs.push(spawnRun(peak, hue));
        pending.splice(i, 1);
      }
    }

    /* ---- live runs: sample, then check for convergence ---- */
    for (const run of runs) {
      if (run.state !== 'running' || reduceMotion) continue;
      const champ = runChampion(run);
      const cy = champ?.ay ?? run.target.y;
      if (cy < viewTop - 600 || cy > viewBot + 600) continue;
      if (frame >= run.nextSample) {
        run.beats++;
        const parents = sampleParents(run, Math.random() < CROSS_P ? 2 : 1);
        if (parents.length) generateChildren(run, parents);
        const near = mouse && champ && (mouse.x - champ.x) ** 2 + (mouse.y - champ.y) ** 2 < 300 * 300;
        run.nextSample = frame + (near ? SAMPLE_EVERY / 2.5 : SAMPLE_EVERY) * (0.7 + Math.random() * 0.6);

        // converged? summit reached, or stagnation (an honest local optimum)
        const c = runChampion(run);
        const onSummit =
          c &&
          (c.ax - run.target.x) ** 2 + (c.ay - run.target.y) ** 2 < (run.target.sigma * 0.6) ** 2 &&
          c.score >= run.target.amp * SUMMIT_FRAC;
        const stagnant = run.beats - run.lastImproveBeat > STAGNATE_BEATS;
        if (onSummit || (stagnant && run.beats > 15)) {
          run.state = 'converged';
          run.convergedAt = frame;
          solvedTotal++;
          // the artifact keeps its structure; failed stubs get cleaned up
          for (const n of run.nodes) if (n.outcome === 'fail') n.removing = true;
        }
      }
    }

    /* ---- perpetual renewal: the search never stops ----
       Whenever live+waiting runs dip below a floor, the oldest frozen
       artifact makes way: it fades, its peak regrows elsewhere in the same
       band, and a fresh run is queued (born when its region is seen). */
    const live = runs.filter((r) => r.state === 'running').length + pending.length;
    const minLive = Math.max(1, Math.round(N_RUNS * 0.4));
    if (!reduceMotion && live < minLive && frame - lastRecycle > RECYCLE_COOLDOWN) {
      const oldest = runs.filter((r) => r.state === 'converged').sort((a, b) => a.convergedAt - b.convergedAt)[0];
      if (oldest) {
        lastRecycle = frame;
        oldest.state = 'fading';
        for (const n of oldest.nodes) n.removing = true;
        const idx = peaks.indexOf(oldest.target);
        const bandH = h / N_RUNS;
        const band = Math.max(0, Math.min(N_RUNS - 1, Math.floor(oldest.target.y / bandH)));
        const fresh = placePeak(band * bandH, (band + 1) * bandH, false);
        if (fresh && idx >= 0) {
          peaks[idx] = fresh;
          pending.push({ peak: fresh, hue: oldest.hue });
        }
      }
    }

    /* ---- node updates (cap applies only to live runs) ---- */
    for (const run of runs) {
      if (run.state === 'running') {
        const liveCount = run.nodes.filter((n) => !n.removing).length;
        if (liveCount > RUN_CAP) {
          const leaves = run.nodes
            .filter((n) => !n.removing && n.children === 0 && n.outcome !== 'root')
            .sort((a, b) => a.score - b.score);
          for (const n of leaves.slice(0, Math.max(4, liveCount - RUN_CAP))) n.removing = true;
        }
      }
      for (const n of run.nodes) {
        const onScreen = n.ay > viewTop && n.ay < viewBot;
        if (!onScreen && n.t >= 1 && !n.removing && n.flash <= 0) continue;
        if (n.t < 1) n.t = Math.min(1, n.t + 1 / GROW_FRAMES);
        const te = ease(n.t);
        const living = n.parents.filter((p) => p.alpha > 0);
        const px = living.length ? living.reduce((s, p) => s + p.x, 0) / living.length : n.ax;
        const py = living.length ? living.reduce((s, p) => s + p.y, 0) / living.length : n.ay;
        const frozen = run.state !== 'running';
        const bx = reduceMotion || frozen ? 0 : Math.sin(frame * 0.008 + n.phase) * 2;
        const by = reduceMotion || frozen ? 0 : Math.cos(frame * 0.009 + n.phase) * 2;
        n.x = px + (n.ax + bx - px) * te;
        n.y = py + (n.ay + by - py) * te;
        if (run.state === 'running' && n.outcome === 'fail' && frame - n.born > FAIL_TTL) n.removing = true;
        if (n.removing) n.alpha = Math.max(0, n.alpha - 0.02);
        else n.alpha = Math.min(n.outcome === 'fail' ? 0.5 : 1, n.alpha + 0.035);
        if (n.flash > 0) n.flash -= 0.025;
      }
      for (let i = run.nodes.length - 1; i >= 0; i--) {
        const n = run.nodes[i];
        if (n.removing && n.alpha <= 0) {
          for (const p of n.parents) p.children--;
          run.nodes.splice(i, 1);
        }
      }
    }
    runs = runs.filter((r) => !(r.state === 'fading' && r.nodes.length === 0));

    /* ---- draw lineage edges ---- */
    for (const run of runs) {
      const dim = run.state === 'running' ? 1 : 0.7; // frozen artifacts recede
      for (const n of run.nodes) {
        for (const p of n.parents) {
          const a = Math.min(n.alpha, p.alpha) * dim;
          if (a <= 0) continue;
          let stroke: string;
          let lw = 0.8;
          if (n.outcome === 'better') {
            stroke = dark ? `hsla(${run.hue}, 70%, 70%, ${0.45 * a})` : `hsla(${run.hue}, 65%, 32%, ${0.4 * a})`;
            lw = 1.1;
          } else if (n.outcome === 'worse') {
            stroke = dark ? `hsla(40, 45%, 60%, ${0.25 * a})` : `hsla(38, 50%, 40%, ${0.22 * a})`;
          } else {
            stroke = dark ? `hsla(5, 65%, 58%, ${0.28 * a})` : `hsla(4, 70%, 42%, ${0.25 * a})`;
          }
          ctx.strokeStyle = stroke;
          ctx.lineWidth = lw;
          ctx.beginPath();
          ctx.moveTo(p.x, p.y);
          ctx.lineTo(n.x, n.y);
          ctx.stroke();
        }
      }
    }

    /* ---- draw nodes ---- */
    for (const run of runs) {
      const dim = run.state === 'running' ? 1 : 0.7;
      for (const n of run.nodes) {
        if (n.alpha <= 0) continue;
        const a = n.alpha * dim;
        let fill: string;
        const r = 1.6 + n.score * 3;
        if (n.outcome === 'fail') {
          fill = dark ? `hsla(5, 70%, 55%, ${0.45 * a})` : `hsla(4, 75%, 45%, ${0.4 * a})`;
        } else if (n.outcome === 'worse') {
          fill = dark ? `hsla(40, 40%, 58%, ${0.5 * a})` : `hsla(38, 45%, 45%, ${0.45 * a})`;
        } else {
          const l = dark ? 55 + n.score * 32 : 45 - n.score * 18;
          fill = `hsla(${run.hue}, 65%, ${l}%, ${(0.45 + n.score * 0.5) * a})`;
        }
        ctx.fillStyle = fill;
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.outcome === 'fail' ? 1.5 : r, 0, Math.PI * 2);
        ctx.fill();

        if (n.flash > 0) {
          ctx.strokeStyle = dark ? `hsla(${run.hue}, 80%, 78%, ${n.flash * 0.6})` : `hsla(${run.hue}, 70%, 35%, ${n.flash * 0.5})`;
          ctx.lineWidth = 1.1;
          ctx.beginPath();
          ctx.arc(n.x, n.y, r + 4 + (1 - n.flash) * 7, 0, Math.PI * 2);
          ctx.stroke();
        }
      }
    }

    /* ---- crown every champion; converged runs get a check ---- */
    ctx.font = '10px ui-monospace, SFMono-Regular, Menlo, monospace';
    ctx.textAlign = 'left';
    for (const run of runs) {
      if (run.state === 'fading') continue;
      const champ = runChampion(run);
      if (!champ) continue;
      const active = run.state === 'running';
      const halo = active ? 6 + Math.sin(frame * 0.06) * 1.5 : 6;
      ctx.strokeStyle = dark ? `hsla(50, 90%, 72%, ${active ? 0.75 : 0.5})` : `hsla(45, 95%, 38%, ${active ? 0.7 : 0.45})`;
      ctx.lineWidth = 1.3;
      ctx.beginPath();
      ctx.arc(champ.x, champ.y, halo, 0, Math.PI * 2);
      ctx.stroke();
      if (!active) {
        ctx.fillStyle = dark ? 'hsla(50, 80%, 75%, 0.6)' : 'hsla(45, 90%, 35%, 0.55)';
        ctx.fillText(`✓ ${champ.score.toFixed(2)}`, champ.x + 10, champ.y + 3);
      }
    }

    if (frame % 20 === 0) {
      const liveNow = runs.filter((r) => r.state === 'running').length;
      statsEl.textContent = `running ${liveNow} · solved ${solvedTotal}`;
    }
    requestAnimationFrame(tick);
  }
  tick();
</script>
