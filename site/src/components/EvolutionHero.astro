---
// Generative hero: evolutionary search with LLMs, island model (FunSearch-style).
//
//   · ISLANDS each hold a growing DAG of programs (a node can have 1–2 parents)
//   · every beat an island samples parents — better-scoring programs are
//     sampled exponentially more often — and the "LLM" generates children:
//     bright island color = improved on the parent, dim amber = worse,
//     red = failed to run (dead branches fade away)
//   · the DAG grows outward from the good branches; weak leaves get pruned
//   · every so often two islands MERGE: champions from both send golden seeds
//     to found a brand-new island whose root descends from both lineages,
//     while the weakest island fades out
---

<div id="evo-hero" class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <canvas id="evo-canvas" class="h-full w-full"></canvas>
  <p
    id="evo-gen"
    class="absolute right-4 bottom-3 font-mono text-[10px] tracking-widest text-ink-400/70 uppercase select-none dark:text-ink-500/70"
  >
    islands 0 · best 0.000 · samples 0
  </p>
</div>

<script>
  const canvas = document.getElementById('evo-canvas') as HTMLCanvasElement;
  const genLabel = document.getElementById('evo-gen')!;
  const ctx = canvas.getContext('2d')!;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let w = 0, h = 0, dpr = 1;
  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    w = canvas.clientWidth;
    h = canvas.clientHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  resize();
  window.addEventListener('resize', resize);

  /* ----------------------- tuning ----------------------- */
  const START_ISLANDS = window.innerWidth < 640 ? 3 : 4;
  const MAX_ISLANDS = START_ISLANDS + 1;
  const ISLAND_CAP = 55;       // max nodes per island before pruning
  const SAMPLE_EVERY = 42;     // frames between sampling beats (per island)
  const GROW_FRAMES = 26;      // child spawn animation length
  const FAIL_P = 0.15;         // chance a generated program fails to run
  const FAIL_TTL = 380;        // failed nodes linger, then vanish
  const MERGE_EVERY = 1250;    // frames between island-merge events
  const CROSS_P = 0.45;        // chance a beat samples TWO parents (in-island crossover)
  const STEP = () => 40 + Math.random() * 28; // edge length parent→child

  const HUES = [172, 205, 260, 140, 305, 95];

  interface PNode {
    isl: Island;
    parents: PNode[];
    children: number;
    ax: number; ay: number;
    x: number; y: number;
    t: number;
    score: number;
    outcome: 'root' | 'merge' | 'better' | 'worse' | 'fail';
    alpha: number;
    removing: boolean;
    born: number;
    phase: number;
    flash: number;
  }
  interface Island {
    cx: number; cy: number;
    hue: number;
    nodes: PNode[];
    nextSample: number;
    wiped: boolean;
  }
  interface MergeEvent {
    from: { x: number; y: number; node: PNode }[];
    to: { x: number; y: number };
    t: number;
    island: Island;
    score: number;
  }

  const islands: Island[] = [];
  let frame = 0;
  let totalSamples = 0;
  let merge: MergeEvent | null = null;

  let mouse: { x: number; y: number } | null = null;
  const hero = document.getElementById('evo-hero')!.parentElement!;
  hero.addEventListener('pointermove', (e) => {
    const rect = canvas.getBoundingClientRect();
    mouse = { x: e.clientX - rect.left, y: e.clientY - rect.top };
  });
  hero.addEventListener('pointerleave', () => (mouse = null));

  function makeNode(isl: Island, parents: PNode[], score: number, outcome: PNode['outcome'], ax: number, ay: number): PNode {
    const px = parents.length ? parents.reduce((s, p) => s + p.x, 0) / parents.length : ax;
    const py = parents.length ? parents.reduce((s, p) => s + p.y, 0) / parents.length : ay;
    return {
      isl, parents, children: 0,
      ax, ay,
      x: px, y: py,
      t: parents.length && !reduceMotion ? 0 : 1,
      score, outcome,
      alpha: 0,
      removing: false,
      born: frame,
      phase: Math.random() * Math.PI * 2,
      flash: 0,
    };
  }

  /** Fitness-proportionate sampling: better programs get sampled more. */
  function samplePool(isl: Island, k: number): PNode[] {
    const pool = isl.nodes.filter((n) => !n.removing && n.outcome !== 'fail' && n.t >= 1);
    const out: PNode[] = [];
    for (let s = 0; s < k && pool.length; s++) {
      const weights = pool.map((n) => Math.exp(n.score * 6));
      let r = Math.random() * weights.reduce((a, b) => a + b, 0);
      let pick = pool.length - 1;
      for (let i = 0; i < pool.length; i++) {
        r -= weights[i];
        if (r <= 0) { pick = i; break; }
      }
      out.push(pool[pick]);
      pool.splice(pick, 1);
    }
    return out;
  }

  function childAnchor(isl: Island, parents: PNode[]): [number, number] {
    const px = parents.reduce((s, p) => s + p.ax, 0) / parents.length;
    const py = parents.reduce((s, p) => s + p.ay, 0) / parents.length;
    const isRootish = parents.some((p) => !p.parents.length);
    const baseDir = isRootish ? Math.random() * Math.PI * 2 : Math.atan2(py - isl.cy, px - isl.cx);
    const dir = baseDir + (Math.random() - 0.5) * 1.6;
    const d = STEP();
    return [
      Math.max(26, Math.min(w - 26, px + Math.cos(dir) * d)),
      Math.max(26, Math.min(h - 26, py + Math.sin(dir) * d)),
    ];
  }

  function generateChildren(isl: Island, parents: PNode[]) {
    const n = 1 + Math.floor(Math.random() * 2.4); // 1–3 programs per prompt
    const pScore = Math.max(...parents.map((p) => p.score));
    for (let k = 0; k < n; k++) {
      const failed = Math.random() < FAIL_P;
      let score = 0;
      let outcome: PNode['outcome'] = 'fail';
      if (!failed) {
        score = Math.min(1, Math.max(0.02, pScore + (Math.random() - 0.42) * 0.16));
        outcome = score > pScore ? 'better' : 'worse';
      }
      const [ax, ay] = childAnchor(isl, parents);
      isl.nodes.push(makeNode(isl, parents, score, outcome, ax, ay));
      for (const p of parents) p.children++;
    }
    for (const p of parents) p.flash = 1;
    totalSamples += n;
  }

  /** Seed an island with a root and an initial brood, so it starts as a graph. */
  function seedIsland(isl: Island, score: number, rootParents: PNode[] = []) {
    const root = makeNode(isl, rootParents, score, rootParents.length ? 'merge' : 'root', isl.cx, isl.cy);
    root.t = 1;
    isl.nodes.push(root);
    isl.wiped = false;
    generateChildren(isl, [root]);
    generateChildren(isl, [root]);
  }

  function findFreeSpot(): { x: number; y: number } {
    let best = { x: w / 2, y: h / 2 };
    let bestD = -1;
    for (let c = 0; c < 14; c++) {
      const x = (0.12 + Math.random() * 0.76) * w;
      const y = (0.16 + Math.random() * 0.68) * h;
      const d = Math.min(...islands.filter((i) => !i.wiped).map((i) => (i.cx - x) ** 2 + (i.cy - y) ** 2), Infinity);
      if (d > bestD) { bestD = d; best = { x, y }; }
    }
    return best;
  }

  const layouts: Record<number, [number, number][]> = {
    3: [[0.18, 0.3], [0.6, 0.72], [0.85, 0.25]],
    4: [[0.15, 0.32], [0.44, 0.74], [0.7, 0.22], [0.88, 0.6]],
  };
  for (let i = 0; i < START_ISLANDS; i++) {
    const [fx, fy] = layouts[START_ISLANDS][i];
    const isl: Island = {
      cx: fx * w, cy: fy * h,
      hue: HUES[i % HUES.length],
      nodes: [],
      nextSample: 30 + i * 20,
      wiped: false,
    };
    islands.push(isl);
    seedIsland(isl, 0.25 + Math.random() * 0.2);
  }

  function bestOf(isl: Island): PNode | null {
    let best: PNode | null = null;
    for (const n of isl.nodes)
      if (!n.removing && n.outcome !== 'fail' && (!best || n.score > best.score)) best = n;
    return best;
  }
  function bestNode(): PNode | null {
    let best: PNode | null = null;
    for (const isl of islands) {
      const b = bestOf(isl);
      if (b && (!best || b.score > best.score)) best = b;
    }
    return best;
  }

  /** Two islands' champions found a NEW island; the weakest island fades out. */
  function mergeIslands() {
    const live = islands.filter((i) => !i.wiped);
    const ranked = live
      .map((isl) => ({ isl, champ: bestOf(isl) }))
      .filter((r) => r.champ)
      .sort((a, b) => b.champ!.score - a.champ!.score);
    if (ranked.length < 2) return;
    const a = ranked[0], b = ranked[1];

    // Make room: fade the weakest island (never one of the merge parents).
    if (live.length >= MAX_ISLANDS) {
      const victim = ranked[ranked.length - 1];
      if (victim.isl === a.isl || victim.isl === b.isl) return;
      for (const n of victim.isl.nodes) n.removing = true;
      victim.isl.wiped = true;
    }

    const spot = findFreeSpot();
    const dh = ((b.isl.hue - a.isl.hue + 540) % 360) - 180;
    const newIsland: Island = {
      cx: spot.x, cy: spot.y,
      hue: (a.isl.hue + dh / 2 + 360) % 360,
      nodes: [],
      nextSample: frame + 60,
      wiped: true, // stays dormant until the seeds arrive
    };
    islands.push(newIsland);
    merge = {
      from: [
        { x: a.champ!.x, y: a.champ!.y, node: a.champ! },
        { x: b.champ!.x, y: b.champ!.y, node: b.champ! },
      ],
      to: spot,
      t: 0,
      island: newIsland,
      score: Math.min(1, Math.max(a.champ!.score, b.champ!.score) * (1 + Math.random() * 0.05)),
    };
  }

  const isDark = () => document.documentElement.classList.contains('dark');
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);

  function tick() {
    frame++;
    ctx.clearRect(0, 0, w, h);
    const dark = isDark();

    /* ---- sampling beats ---- */
    for (const isl of islands) {
      if (isl.wiped) continue;
      const near = mouse && (mouse.x - isl.cx) ** 2 + (mouse.y - isl.cy) ** 2 < 280 * 280;
      if (frame >= isl.nextSample) {
        const k = Math.random() < CROSS_P ? 2 : 1;
        const parents = samplePool(isl, k);
        if (parents.length && !reduceMotion) generateChildren(isl, parents);
        isl.nextSample = frame + (near ? SAMPLE_EVERY / 3 : SAMPLE_EVERY) * (0.7 + Math.random() * 0.6);
      }
    }

    /* ---- merge events ---- */
    if (!reduceMotion && frame % MERGE_EVERY === 0 && frame > 500 && !merge) mergeIslands();
    if (merge) {
      merge.t += 0.016;
      const t = ease(Math.min(1, merge.t));
      for (const f of merge.from) {
        const sx = f.x + (merge.to.x - f.x) * t;
        const sy = f.y + (merge.to.y - f.y) * t;
        ctx.fillStyle = dark ? 'hsla(50, 90%, 70%, 0.95)' : 'hsla(45, 90%, 40%, 0.95)';
        ctx.beginPath();
        ctx.arc(sx, sy, 3.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = dark ? 'hsla(50, 90%, 70%, 0.25)' : 'hsla(45, 90%, 40%, 0.25)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(f.x, f.y);
        ctx.lineTo(sx, sy);
        ctx.stroke();
      }
      if (merge.t >= 1) {
        seedIsland(merge.island, merge.score, merge.from.map((f) => f.node));
        merge = null;
      }
    }

    /* ---- update + prune ---- */
    for (const isl of islands) {
      if (isl.nodes.filter((n) => !n.removing).length > ISLAND_CAP) {
        const leaves = isl.nodes
          .filter((n) => !n.removing && n.children === 0 && n.outcome !== 'root' && n.outcome !== 'merge')
          .sort((a, b) => a.score - b.score);
        for (const n of leaves.slice(0, 6)) n.removing = true;
      }
      for (const n of isl.nodes) {
        if (n.t < 1) n.t = Math.min(1, n.t + 1 / GROW_FRAMES);
        const te = ease(n.t);
        const livingParents = n.parents.filter((p) => p.alpha > 0);
        const px = livingParents.length ? livingParents.reduce((s, p) => s + p.x, 0) / livingParents.length : n.ax;
        const py = livingParents.length ? livingParents.reduce((s, p) => s + p.y, 0) / livingParents.length : n.ay;
        const bx = reduceMotion ? 0 : Math.sin(frame * 0.008 + n.phase) * 2;
        const by = reduceMotion ? 0 : Math.cos(frame * 0.009 + n.phase) * 2;
        n.x = px + (n.ax + bx - px) * te;
        n.y = py + (n.ay + by - py) * te;
        if (n.outcome === 'fail' && frame - n.born > FAIL_TTL) n.removing = true;
        if (n.removing) n.alpha = Math.max(0, n.alpha - 0.02);
        else n.alpha = Math.min(n.outcome === 'fail' ? 0.55 : 1, n.alpha + 0.035);
        if (n.flash > 0) n.flash -= 0.025;
      }
      for (let i = isl.nodes.length - 1; i >= 0; i--) {
        const n = isl.nodes[i];
        if (n.removing && n.alpha <= 0) {
          for (const p of n.parents) p.children--;
          isl.nodes.splice(i, 1);
        }
      }
    }
    // drop islands that have fully faded
    for (let i = islands.length - 1; i >= 0; i--) {
      if (islands[i].wiped && islands[i].nodes.length === 0 && islands[i] !== merge?.island) islands.splice(i, 1);
    }

    const champ = bestNode();

    /* ---- draw edges (lineage DAG; multi-parent nodes draw one per parent) ---- */
    for (const isl of islands) {
      for (const n of isl.nodes) {
        for (const p of n.parents) {
          const a = Math.min(n.alpha, p.alpha);
          if (a <= 0) continue;
          const crossIsland = p.isl !== n.isl;
          let stroke: string;
          let lw = 0.8;
          if (crossIsland || n.outcome === 'merge') {
            stroke = dark ? `hsla(50, 80%, 70%, ${0.35 * a})` : `hsla(45, 85%, 38%, ${0.3 * a})`;
            lw = 1;
          } else if (n.outcome === 'better') {
            stroke = dark ? `hsla(${isl.hue}, 70%, 70%, ${0.5 * a})` : `hsla(${isl.hue}, 65%, 32%, ${0.45 * a})`;
            lw = 1.1;
          } else if (n.outcome === 'worse') {
            stroke = dark ? `hsla(40, 45%, 60%, ${0.28 * a})` : `hsla(38, 50%, 40%, ${0.25 * a})`;
          } else {
            stroke = dark ? `hsla(5, 65%, 58%, ${0.3 * a})` : `hsla(4, 70%, 42%, ${0.28 * a})`;
          }
          ctx.strokeStyle = stroke;
          ctx.lineWidth = lw;
          ctx.beginPath();
          ctx.moveTo(p.x, p.y);
          ctx.lineTo(n.x, n.y);
          ctx.stroke();
        }
      }
    }

    /* ---- draw nodes ---- */
    for (const isl of islands) {
      for (const n of isl.nodes) {
        if (n.alpha <= 0) continue;
        let fill: string;
        const r = 1.6 + n.score * 3.2;
        if (n.outcome === 'fail') {
          fill = dark ? `hsla(5, 70%, 55%, ${0.5 * n.alpha})` : `hsla(4, 75%, 45%, ${0.45 * n.alpha})`;
        } else if (n.outcome === 'worse') {
          fill = dark ? `hsla(40, 40%, 58%, ${0.55 * n.alpha})` : `hsla(38, 45%, 45%, ${0.5 * n.alpha})`;
        } else {
          const l = dark ? 55 + n.score * 32 : 45 - n.score * 18;
          fill = `hsla(${isl.hue}, 65%, ${l}%, ${(0.5 + n.score * 0.5) * n.alpha})`;
        }
        ctx.fillStyle = fill;
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.outcome === 'fail' ? 1.6 : r, 0, Math.PI * 2);
        ctx.fill();

        if (n.flash > 0) {
          ctx.strokeStyle = dark ? `hsla(${isl.hue}, 80%, 78%, ${n.flash * 0.7})` : `hsla(${isl.hue}, 70%, 35%, ${n.flash * 0.6})`;
          ctx.lineWidth = 1.2;
          ctx.beginPath();
          ctx.arc(n.x, n.y, r + 4 + (1 - n.flash) * 8, 0, Math.PI * 2);
          ctx.stroke();
        }
      }
    }

    /* ---- crown the global champion ---- */
    if (champ) {
      const halo = 6 + Math.sin(frame * 0.06) * 1.5;
      ctx.strokeStyle = dark ? 'hsla(50, 90%, 72%, 0.8)' : 'hsla(45, 95%, 38%, 0.75)';
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.arc(champ.x, champ.y, halo, 0, Math.PI * 2);
      ctx.stroke();
    }

    if (frame % 20 === 0) {
      const live = islands.filter((i) => !i.wiped).length;
      genLabel.textContent = `islands ${live} · best ${(champ?.score ?? 0).toFixed(3)} · samples ${totalSamples}`;
    }
    requestAnimationFrame(tick);
  }
  tick();
</script>
