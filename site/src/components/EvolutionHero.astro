---
// Generative hero: evolutionary search with LLMs, island model (FunSearch-style).
//
//   · several ISLANDS each hold a growing TREE of programs
//   · every beat, an island samples parents — better-scoring nodes are
//     sampled more often — and the "LLM" generates child programs
//   · children are scored against their parent and colored by outcome:
//     brighter island color = improved, dim amber = worse, red = failed to run
//   · trees grow outward from the good branches (that's the point: search
//     concentrates where the scores are), weak leaves get pruned
//   · stagnating islands are periodically WIPED and reseeded from the global
//     champion — watch for the traveling seed
---

<div id="evo-hero" class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <canvas id="evo-canvas" class="h-full w-full"></canvas>
  <p
    id="evo-gen"
    class="absolute right-4 bottom-3 font-mono text-[10px] tracking-widest text-ink-400/70 uppercase select-none dark:text-ink-500/70"
  >
    best 0.000 · samples 0
  </p>
</div>

<script>
  const canvas = document.getElementById('evo-canvas') as HTMLCanvasElement;
  const genLabel = document.getElementById('evo-gen')!;
  const ctx = canvas.getContext('2d')!;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let w = 0, h = 0, dpr = 1;
  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    w = canvas.clientWidth;
    h = canvas.clientHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  resize();
  window.addEventListener('resize', resize);

  /* ----------------------- tuning ----------------------- */
  const N_ISLANDS = window.innerWidth < 640 ? 3 : 4;
  const ISLAND_CAP = 64;        // max nodes per island before pruning kicks in
  const SAMPLE_EVERY = 85;      // frames between sampling beats (per island)
  const GROW_FRAMES = 36;       // child spawn animation length
  const FAIL_P = 0.16;          // chance a generated program fails to run
  const FAIL_TTL = 420;         // failed nodes linger this long, then vanish
  const RESTART_EVERY = 1500;   // frames between island restarts
  const STEP = () => 26 + Math.random() * 22; // edge length parent→child

  // Island base hues: each gene pool gets its own color family.
  const HUES = [172, 205, 260, 140, 305];

  interface PNode {
    island: number;
    parent: PNode | null;
    children: number;
    ax: number; ay: number;   // anchor (tree layout) position
    x: number; y: number;     // displayed position (animated)
    t: number;                // spawn animation progress 0→1
    score: number;
    outcome: 'root' | 'better' | 'worse' | 'fail';
    alpha: number;
    removing: boolean;
    born: number;
    phase: number;            // breathing offset
    flash: number;            // sampling highlight
  }
  interface Island {
    cx: number; cy: number;
    hue: number;
    nodes: PNode[];
    nextSample: number;
    wiped: boolean;
  }
  interface Seed { x0: number; y0: number; x1: number; y1: number; t: number; score: number; island: number }

  const islands: Island[] = [];
  const layouts: Record<number, [number, number][]> = {
    3: [[0.2, 0.32], [0.62, 0.7], [0.84, 0.25]],
    4: [[0.16, 0.34], [0.46, 0.72], [0.7, 0.24], [0.88, 0.62]],
  };
  for (let i = 0; i < N_ISLANDS; i++) {
    const [fx, fy] = layouts[N_ISLANDS][i];
    islands.push({
      cx: fx * w, cy: fy * h,
      hue: HUES[i % HUES.length],
      nodes: [],
      nextSample: 40 + i * 28, // stagger the beats
      wiped: false,
    });
  }

  let frame = 0;
  let totalSamples = 0;
  let seed: Seed | null = null;

  let mouse: { x: number; y: number } | null = null;
  const hero = document.getElementById('evo-hero')!.parentElement!;
  hero.addEventListener('pointermove', (e) => {
    const rect = canvas.getBoundingClientRect();
    mouse = { x: e.clientX - rect.left, y: e.clientY - rect.top };
  });
  hero.addEventListener('pointerleave', () => (mouse = null));

  function makeNode(island: number, parent: PNode | null, score: number, outcome: PNode['outcome'], ax: number, ay: number): PNode {
    return {
      island, parent, children: 0,
      ax, ay,
      x: parent ? parent.x : ax,
      y: parent ? parent.y : ay,
      t: reduceMotion ? 1 : 0,
      score, outcome,
      alpha: 0,
      removing: false,
      born: frame,
      phase: Math.random() * Math.PI * 2,
      flash: 0,
    };
  }

  function seedIsland(isl: Island, score: number) {
    isl.nodes.push(makeNode(islands.indexOf(isl), null, score, 'root', isl.cx, isl.cy));
    isl.wiped = false;
  }
  for (const isl of islands) seedIsland(isl, 0.25 + Math.random() * 0.2);

  /** Fitness-proportionate parent sampling: better programs get sampled more. */
  function sampleParent(isl: Island): PNode | null {
    const pool = isl.nodes.filter((n) => !n.removing && n.outcome !== 'fail' && n.t >= 1);
    if (!pool.length) return null;
    const weights = pool.map((n) => Math.exp(n.score * 6));
    let r = Math.random() * weights.reduce((a, b) => a + b, 0);
    for (let i = 0; i < pool.length; i++) {
      r -= weights[i];
      if (r <= 0) return pool[i];
    }
    return pool[pool.length - 1];
  }

  function generateChildren(isl: Island, parent: PNode) {
    const n = 1 + Math.floor(Math.random() * 2.4); // 1–3 programs per prompt
    for (let k = 0; k < n; k++) {
      const failed = Math.random() < FAIL_P;
      let score = 0;
      let outcome: PNode['outcome'] = 'fail';
      if (!failed) {
        // LLM proposal: usually nearby, sometimes a real improvement.
        score = Math.min(1, Math.max(0.02, parent.score + (Math.random() - 0.42) * 0.16));
        outcome = score > parent.score ? 'better' : 'worse';
      }
      // Grow outward: away from the island root, fanned per child.
      const baseDir = parent.parent
        ? Math.atan2(parent.ay - isl.cy, parent.ax - isl.cx)
        : Math.random() * Math.PI * 2;
      const dir = baseDir + (Math.random() - 0.5) * 1.5;
      const d = STEP();
      let ax = parent.ax + Math.cos(dir) * d;
      let ay = parent.ay + Math.sin(dir) * d;
      // Soft-bound inside the canvas.
      ax = Math.max(24, Math.min(w - 24, ax));
      ay = Math.max(24, Math.min(h - 24, ay));
      isl.nodes.push(makeNode(parent.island, parent, score, outcome, ax, ay));
      parent.children++;
    }
    parent.flash = 1;
    totalSamples += n;
  }

  function bestNode(): PNode | null {
    let best: PNode | null = null;
    for (const isl of islands)
      for (const n of isl.nodes)
        if (!n.removing && n.outcome !== 'fail' && (!best || n.score > best.score)) best = n;
    return best;
  }

  /** Wipe the weakest island; reseed it from the global champion (migration). */
  function restartWeakest() {
    const scoredIslands = islands.map((isl) => ({
      isl,
      best: Math.max(0, ...isl.nodes.filter((n) => !n.removing && n.outcome !== 'fail').map((n) => n.score)),
    }));
    scoredIslands.sort((a, b) => a.best - b.best);
    const victim = scoredIslands[0].isl;
    const champ = bestNode();
    if (!champ || islands[champ.island] === victim) return;
    for (const n of victim.nodes) n.removing = true;
    victim.wiped = true;
    seed = {
      x0: champ.x, y0: champ.y,
      x1: victim.cx, y1: victim.cy,
      t: 0,
      score: champ.score * (0.88 + Math.random() * 0.08),
      island: islands.indexOf(victim),
    };
  }

  const isDark = () => document.documentElement.classList.contains('dark');
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);

  function tick() {
    frame++;
    ctx.clearRect(0, 0, w, h);
    const dark = isDark();

    /* ---- sampling beats ---- */
    for (const isl of islands) {
      if (isl.wiped) continue;
      // Hovering near an island turns up its sampling temperature.
      const near = mouse && (mouse.x - isl.cx) ** 2 + (mouse.y - isl.cy) ** 2 < 280 * 280;
      if (frame >= isl.nextSample) {
        const parent = sampleParent(isl);
        if (parent && !reduceMotion) generateChildren(isl, parent);
        isl.nextSample = frame + (near ? SAMPLE_EVERY / 3 : SAMPLE_EVERY) * (0.7 + Math.random() * 0.6);
      }
    }

    /* ---- island restarts (punctuation) ---- */
    if (!reduceMotion && frame % RESTART_EVERY === 0 && frame > 600) restartWeakest();
    if (seed) {
      seed.t += 0.02;
      const t = ease(Math.min(1, seed.t));
      const sx = seed.x0 + (seed.x1 - seed.x0) * t;
      const sy = seed.y0 + (seed.y1 - seed.y0) * t;
      ctx.fillStyle = dark ? 'hsla(50, 90%, 70%, 0.95)' : 'hsla(45, 90%, 40%, 0.95)';
      ctx.beginPath();
      ctx.arc(sx, sy, 3.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = dark ? 'hsla(50, 90%, 70%, 0.3)' : 'hsla(45, 90%, 40%, 0.3)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(sx, sy, 8, 0, Math.PI * 2);
      ctx.stroke();
      if (seed.t >= 1) {
        seedIsland(islands[seed.island], seed.score);
        seed = null;
      }
    }

    /* ---- update + prune ---- */
    for (const isl of islands) {
      // prune: cap tree size by retiring the weakest leaves
      if (isl.nodes.filter((n) => !n.removing).length > ISLAND_CAP) {
        const leaves = isl.nodes
          .filter((n) => !n.removing && n.children === 0 && n.outcome !== 'root')
          .sort((a, b) => a.score - b.score);
        for (const n of leaves.slice(0, 6)) n.removing = true;
      }
      for (const n of isl.nodes) {
        if (n.t < 1) n.t = Math.min(1, n.t + 1 / GROW_FRAMES);
        const te = ease(n.t);
        const px = n.parent ? n.parent.x : n.ax;
        const py = n.parent ? n.parent.y : n.ay;
        // breathe gently around the anchor
        const bx = reduceMotion ? 0 : Math.sin(frame * 0.008 + n.phase) * 2;
        const by = reduceMotion ? 0 : Math.cos(frame * 0.009 + n.phase) * 2;
        n.x = px + (n.ax + bx - px) * te;
        n.y = py + (n.ay + by - py) * te;
        if (n.outcome === 'fail' && frame - n.born > FAIL_TTL) n.removing = true;
        if (n.removing) n.alpha = Math.max(0, n.alpha - 0.02);
        else n.alpha = Math.min(n.outcome === 'fail' ? 0.55 : 1, n.alpha + 0.03);
        if (n.flash > 0) n.flash -= 0.025;
      }
      // actually remove fully faded nodes (and fix parent child counts)
      for (let i = isl.nodes.length - 1; i >= 0; i--) {
        const n = isl.nodes[i];
        if (n.removing && n.alpha <= 0) {
          if (n.parent) n.parent.children--;
          isl.nodes.splice(i, 1);
        }
      }
    }

    const champ = bestNode();

    /* ---- draw edges (lineage tree) ---- */
    for (const isl of islands) {
      for (const n of isl.nodes) {
        if (!n.parent) continue;
        const a = Math.min(n.alpha, n.parent.alpha);
        if (a <= 0) continue;
        let stroke: string;
        if (n.outcome === 'better') stroke = dark ? `hsla(${isl.hue}, 70%, 70%, ${0.5 * a})` : `hsla(${isl.hue}, 65%, 32%, ${0.45 * a})`;
        else if (n.outcome === 'worse') stroke = dark ? `hsla(40, 45%, 60%, ${0.28 * a})` : `hsla(38, 50%, 40%, ${0.25 * a})`;
        else stroke = dark ? `hsla(5, 65%, 58%, ${0.3 * a})` : `hsla(4, 70%, 42%, ${0.28 * a})`;
        ctx.strokeStyle = stroke;
        ctx.lineWidth = n.outcome === 'better' ? 1.1 : 0.8;
        ctx.beginPath();
        ctx.moveTo(n.parent.x, n.parent.y);
        ctx.lineTo(n.x, n.y);
        ctx.stroke();
      }
    }

    /* ---- draw nodes ---- */
    for (const isl of islands) {
      for (const n of isl.nodes) {
        if (n.alpha <= 0) continue;
        let fill: string;
        const r = 1.6 + n.score * 3.2;
        if (n.outcome === 'fail') {
          fill = dark ? `hsla(5, 70%, 55%, ${0.5 * n.alpha})` : `hsla(4, 75%, 45%, ${0.45 * n.alpha})`;
        } else if (n.outcome === 'worse') {
          fill = dark ? `hsla(40, 40%, 58%, ${0.55 * n.alpha})` : `hsla(38, 45%, 45%, ${0.5 * n.alpha})`;
        } else {
          const l = dark ? 55 + n.score * 32 : 45 - n.score * 18;
          fill = `hsla(${isl.hue}, 65%, ${l}%, ${(0.5 + n.score * 0.5) * n.alpha})`;
        }
        ctx.fillStyle = fill;
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.outcome === 'fail' ? 1.6 : r, 0, Math.PI * 2);
        ctx.fill();

        // sampling flash on chosen parents
        if (n.flash > 0) {
          ctx.strokeStyle = dark ? `hsla(${isl.hue}, 80%, 78%, ${n.flash * 0.7})` : `hsla(${isl.hue}, 70%, 35%, ${n.flash * 0.6})`;
          ctx.lineWidth = 1.2;
          ctx.beginPath();
          ctx.arc(n.x, n.y, r + 4 + (1 - n.flash) * 8, 0, Math.PI * 2);
          ctx.stroke();
        }
      }
    }

    /* ---- crown the global champion ---- */
    if (champ) {
      const halo = 6 + Math.sin(frame * 0.06) * 1.5;
      ctx.strokeStyle = dark ? 'hsla(50, 90%, 72%, 0.8)' : 'hsla(45, 95%, 38%, 0.75)';
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.arc(champ.x, champ.y, halo, 0, Math.PI * 2);
      ctx.stroke();
    }

    if (frame % 20 === 0) {
      genLabel.textContent = `best ${(champ?.score ?? 0).toFixed(3)} · samples ${totalSamples}`;
    }
    requestAnimationFrame(tick);
  }
  tick();
</script>
