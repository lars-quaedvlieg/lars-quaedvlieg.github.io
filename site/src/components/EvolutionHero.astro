---
// Generative "evolutionary search" ecosystem. Designed to NEVER settle:
//   · candidate solutions climb a fitness landscape and reproduce via
//     crossover when connected (links = courtship; offspring biased toward
//     the fitter parent, with blended + mutated color genes)
//   · habitats DEPLETE: a crowded peak runs out of resource, collapses, and
//     erupts somewhere else — forcing mass migrations
//   · PREDATORS hunt dense clusters (a nod to my predator–prey RL project);
//     prey scatter, predators starve when the swarm thins, bloom follows bust
//   · game-of-life pressure: overcrowding and isolation both kill
// The result is endless punctuated equilibrium rather than convergence.
---

<div id="evo-hero" class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <canvas id="evo-canvas" class="h-full w-full"></canvas>
  <p
    id="evo-gen"
    class="absolute right-4 bottom-3 font-mono text-[10px] tracking-widest text-ink-400/70 uppercase select-none dark:text-ink-500/70"
  >
    gen 0 · pop 0
  </p>
</div>

<script>
  const canvas = document.getElementById('evo-canvas') as HTMLCanvasElement;
  const genLabel = document.getElementById('evo-gen')!;
  const ctx = canvas.getContext('2d')!;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let w = 0, h = 0, dpr = 1;
  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    w = canvas.clientWidth;
    h = canvas.clientHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  resize();
  window.addEventListener('resize', resize);

  /* ----------------------- tuning ----------------------- */
  const BASE_POP = Math.min(90, Math.floor(window.innerWidth * 0.055) + 35);
  const CAP = Math.floor(BASE_POP * 1.8);
  const LINK_R = 120;        // connection ("courtship") radius
  const CROSSOVER_P = 0.004; // per-link per-frame chance of offspring
  const CROWD_LIMIT = 8;     // game-of-life overcrowding threshold
  const LONELY_FRAMES = 260; // isolated this long → wither
  const MATURITY = 50;       // frames before a node can reproduce
  const N_PREDATORS = 2;
  const FLEE_R = 110;        // prey panic radius around predators
  const EAT_R = 13;

  interface Particle {
    x: number; y: number; vx: number; vy: number;
    hue: number; r: number;
    age: number; alpha: number; dying: boolean;
    lonely: number; cooldown: number;
  }
  interface Predator { x: number; y: number; vx: number; vy: number; energy: number }
  interface Pulse { x: number; y: number; t: number; hue: number; death?: boolean }
  interface Peak {
    x: number; y: number; vx: number; vy: number;
    strength: number;  // ramps 0→1 on eruption, 1→0 on collapse
    resource: number;  // depleted by nearby population
    collapsing: boolean;
  }

  const particles: Particle[] = [];
  const predators: Predator[] = [];
  const pulses: Pulse[] = [];
  const peaks: Peak[] = [];
  let generation = 0;
  let frame = 0;

  function newPeak(): Peak {
    return {
      x: (0.12 + Math.random() * 0.76) * w,
      y: (0.15 + Math.random() * 0.7) * h,
      vx: (Math.random() - 0.5) * 0.25,
      vy: (Math.random() - 0.5) * 0.25,
      strength: 0,
      resource: 1,
      collapsing: false,
    };
  }
  for (let i = 0; i < 3; i++) {
    const pk = newPeak();
    pk.strength = 1;
    pk.resource = 0.4 + Math.random() * 0.6; // desynchronize first collapses
    peaks.push(pk);
  }

  let mouse: { x: number; y: number } | null = null;
  const hero = document.getElementById('evo-hero')!.parentElement!;
  hero.addEventListener('pointermove', (e) => {
    const rect = canvas.getBoundingClientRect();
    mouse = { x: e.clientX - rect.left, y: e.clientY - rect.top };
  });
  hero.addEventListener('pointerleave', () => (mouse = null));

  function spawn(x?: number, y?: number, hue?: number, r?: number): Particle {
    return {
      x: x ?? Math.random() * w,
      y: y ?? Math.random() * h,
      vx: (Math.random() - 0.5) * 0.4,
      vy: (Math.random() - 0.5) * 0.4,
      hue: hue !== undefined ? (hue + (Math.random() - 0.5) * 18 + 360) % 360 : 150 + Math.random() * 80,
      r: r !== undefined ? Math.max(1, r + (Math.random() - 0.5) * 0.5) : 1.2 + Math.random() * 1.8,
      age: 0,
      alpha: 0,
      dying: false,
      lonely: 0,
      cooldown: 0,
    };
  }
  for (let i = 0; i < BASE_POP; i++) particles.push(spawn());
  for (let i = 0; i < N_PREDATORS; i++) {
    predators.push({ x: Math.random() * w, y: Math.random() * h, vx: 0, vy: 0, energy: 1 });
  }

  function fitness(x: number, y: number): number {
    let f = 0;
    for (const pk of peaks) {
      const amp = pk.strength * (0.35 + 0.65 * pk.resource);
      if (amp < 0.02) continue;
      const d2 = (x - pk.x) ** 2 + (y - pk.y) ** 2;
      f += amp * Math.exp(-d2 / (2 * (w * 0.16) ** 2));
    }
    if (mouse) {
      const d2 = (x - mouse.x) ** 2 + (y - mouse.y) ** 2;
      f += 1.2 * Math.exp(-d2 / (2 * (w * 0.14) ** 2));
    }
    return f;
  }

  function crossover(a: Particle, b: Particle) {
    const fa = fitness(a.x, a.y), fb = fitness(b.x, b.y);
    const bias = fb + fa < 1e-6 ? 0.5 : fa / (fa + fb);
    const cx = a.x * bias + b.x * (1 - bias) + (Math.random() - 0.5) * 30;
    const cy = a.y * bias + b.y * (1 - bias) + (Math.random() - 0.5) * 30;
    const dh = ((b.hue - a.hue + 540) % 360) - 180;
    const hue = (a.hue + dh * (1 - bias) + 360) % 360;
    const child = spawn(cx, cy, hue, (a.r + b.r) / 2);
    child.alpha = 0.1;
    particles.push(child);
    pulses.push({ x: cx, y: cy, t: 0, hue });
    a.cooldown = b.cooldown = 90;
  }

  function selectionSweep() {
    generation++;
    const alive = particles.filter((p) => !p.dying);
    const scored = alive.map((p) => ({ p, f: fitness(p.x, p.y) })).sort((a, b) => b.f - a.f);
    for (const { p } of scored.slice(Math.floor(scored.length * 0.9))) p.dying = true;
    while (particles.filter((p) => !p.dying).length < BASE_POP * 0.55) {
      const im = spawn();
      im.alpha = 0.05;
      particles.push(im);
    }
  }
  if (!reduceMotion) setInterval(selectionSweep, 3200);

  const isDark = () => document.documentElement.classList.contains('dark');

  function tick() {
    frame++;
    ctx.clearRect(0, 0, w, h);
    const dark = isDark();

    /* ---- habitat dynamics: wandering, depleting, erupting peaks ---- */
    for (let k = 0; k < peaks.length; k++) {
      const pk = peaks[k];
      pk.x += pk.vx;
      pk.y += pk.vy;
      if (pk.x < w * 0.08 || pk.x > w * 0.92) pk.vx *= -1;
      if (pk.y < h * 0.1 || pk.y > h * 0.9) pk.vy *= -1;

      if (!pk.collapsing) {
        pk.strength = Math.min(1, pk.strength + 0.004);
        // population near the peak eats its resource
        let grazing = 0;
        for (const p of particles) {
          if (!p.dying && (p.x - pk.x) ** 2 + (p.y - pk.y) ** 2 < (w * 0.13) ** 2) grazing++;
        }
        pk.resource = Math.min(1, pk.resource - grazing * 0.000055 + 0.0003);
        if (pk.resource < 0.18) pk.collapsing = true; // habitat exhausted
      } else {
        pk.strength -= 0.006;
        if (pk.strength <= 0) peaks[k] = newPeak(); // erupt somewhere fresh
      }
    }

    /* ---- prey movement: gradient ascent + flee predators ---- */
    for (const p of particles) {
      const eps = 4;
      p.vx += (fitness(p.x + eps, p.y) - fitness(p.x - eps, p.y)) * 1.1 + (Math.random() - 0.5) * 0.05;
      p.vy += (fitness(p.x, p.y + eps) - fitness(p.x, p.y - eps)) * 1.1 + (Math.random() - 0.5) * 0.05;
      for (const pr of predators) {
        const dx = p.x - pr.x, dy = p.y - pr.y;
        const d2 = dx * dx + dy * dy;
        if (d2 < FLEE_R * FLEE_R && d2 > 1) {
          const panic = (1 - Math.sqrt(d2) / FLEE_R) * 0.5;
          p.vx += (dx / Math.sqrt(d2)) * panic;
          p.vy += (dy / Math.sqrt(d2)) * panic;
        }
      }
      // soft walls
      if (p.x < 30) p.vx += 0.04; if (p.x > w - 30) p.vx -= 0.04;
      if (p.y < 30) p.vy += 0.04; if (p.y > h - 30) p.vy -= 0.04;
      p.vx *= 0.96;
      p.vy *= 0.96;
      if (!reduceMotion) { p.x += p.vx; p.y += p.vy; }
      p.age++;
      if (p.cooldown > 0) p.cooldown--;
      if (p.dying) p.alpha = Math.max(0, p.alpha - 0.015);
      else p.alpha = Math.min(1, p.alpha + 0.025);
    }

    /* ---- predators: hunt local prey density, eat, starve ---- */
    for (const pr of predators) {
      let tx = 0, ty = 0, tw = 0;
      for (const p of particles) {
        if (p.dying) continue;
        const d2 = (p.x - pr.x) ** 2 + (p.y - pr.y) ** 2;
        if (d2 < 260 * 260) {
          const wgt = 1 / (d2 + 2000);
          tx += p.x * wgt; ty += p.y * wgt; tw += wgt;
          if (!reduceMotion && d2 < EAT_R * EAT_R && Math.random() < 0.25) {
            p.dying = true;
            pr.energy = Math.min(1.6, pr.energy + 0.25);
            pulses.push({ x: p.x, y: p.y, t: 0, hue: 8, death: true });
          }
        }
      }
      const speed = 0.05 + pr.energy * 0.04;
      if (tw > 0) {
        pr.vx += (tx / tw - pr.x) * 0.0016 * (speed * 20);
        pr.vy += (ty / tw - pr.y) * 0.0016 * (speed * 20);
      } else {
        pr.vx += (Math.random() - 0.5) * 0.12; // no prey in sight: wander
        pr.vy += (Math.random() - 0.5) * 0.12;
      }
      pr.energy = Math.max(0.15, pr.energy - 0.0006); // starving predators slow down
      if (pr.x < 20) pr.vx += 0.06; if (pr.x > w - 20) pr.vx -= 0.06;
      if (pr.y < 20) pr.vy += 0.06; if (pr.y > h - 20) pr.vy -= 0.06;
      pr.vx *= 0.97;
      pr.vy *= 0.97;
      if (!reduceMotion) { pr.x += pr.vx; pr.y += pr.vy; }
    }

    /* ---- links + crossover + neighbor counts ---- */
    const neighborCount = new Array(particles.length).fill(0);
    ctx.lineWidth = 0.7;
    for (let i = 0; i < particles.length; i++) {
      const a = particles[i];
      if (a.dying) continue;
      for (let j = i + 1; j < particles.length; j++) {
        const b = particles[j];
        if (b.dying) continue;
        const d2 = (a.x - b.x) ** 2 + (a.y - b.y) ** 2;
        if (d2 < LINK_R * LINK_R) {
          neighborCount[i]++;
          neighborCount[j]++;
          const closeness = 1 - d2 / (LINK_R * LINK_R);
          const glow = Math.min(1, (fitness(a.x, a.y) + fitness(b.x, b.y)) / 2);
          const o = closeness * (0.1 + glow * 0.22) * a.alpha * b.alpha;
          ctx.strokeStyle = dark ? `hsla(${(a.hue + b.hue) / 2}, 60%, 70%, ${o})` : `hsla(${(a.hue + b.hue) / 2}, 55%, 32%, ${o})`;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
          if (
            !reduceMotion &&
            particles.length < CAP &&
            a.age > MATURITY && b.age > MATURITY &&
            a.cooldown === 0 && b.cooldown === 0 &&
            Math.random() < CROSSOVER_P * (0.4 + glow)
          ) {
            crossover(a, b);
          }
        }
      }
    }

    /* ---- game-of-life pressure ---- */
    for (let i = 0; i < particles.length; i++) {
      const p = particles[i];
      if (p.dying) continue;
      if (neighborCount[i] > CROWD_LIMIT && Math.random() < 0.03) p.dying = true;
      if (neighborCount[i] === 0) {
        if (++p.lonely > LONELY_FRAMES) p.dying = true;
      } else {
        p.lonely = 0;
      }
    }
    for (let i = particles.length - 1; i >= 0; i--) {
      if (particles[i].dying && particles[i].alpha <= 0) particles.splice(i, 1);
    }

    /* ---- pulses: green birth rings, red death flashes ---- */
    for (let i = pulses.length - 1; i >= 0; i--) {
      const pu = pulses[i];
      pu.t += pu.death ? 0.05 : 0.03;
      if (pu.t >= 1) { pulses.splice(i, 1); continue; }
      const rad = pu.death ? 2 + pu.t * 14 : 4 + pu.t * 26;
      const o = (1 - pu.t) * (pu.death ? 0.6 : 0.5);
      ctx.strokeStyle = dark ? `hsla(${pu.hue}, 75%, ${pu.death ? 62 : 75}%, ${o})` : `hsla(${pu.hue}, 70%, ${pu.death ? 45 : 35}%, ${o})`;
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.arc(pu.x, pu.y, rad, 0, Math.PI * 2);
      ctx.stroke();
    }

    /* ---- draw prey ---- */
    for (const p of particles) {
      const f = Math.min(1, fitness(p.x, p.y));
      const l = dark ? 58 + f * 28 : 40 - f * 12;
      ctx.fillStyle = `hsla(${p.hue}, 60%, ${l}%, ${(0.35 + f * 0.55) * p.alpha})`;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r + f * 2, 0, Math.PI * 2);
      ctx.fill();
    }

    /* ---- draw predators: amber, ringed, slightly menacing ---- */
    for (const pr of predators) {
      const core = dark ? `hsla(18, 85%, 65%, 0.9)` : `hsla(14, 80%, 42%, 0.85)`;
      ctx.fillStyle = core;
      ctx.beginPath();
      ctx.arc(pr.x, pr.y, 3 + pr.energy * 1.6, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = dark ? `hsla(18, 85%, 65%, 0.35)` : `hsla(14, 80%, 42%, 0.3)`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(pr.x, pr.y, 8 + pr.energy * 3, 0, Math.PI * 2);
      ctx.stroke();
    }

    if (frame % 30 === 0) genLabel.textContent = `gen ${generation} · pop ${particles.length}`;
    requestAnimationFrame(tick);
  }
  tick();
</script>
