---
import type { Publication } from '../lib/bibtex';
import { pdfUrl, previewUrl } from '../lib/bibtex';
import { withBase } from '../lib/site';

interface Props {
  pub: Publication;
}
const { pub } = Astro.props;
---

<article
  data-evo-block
 
  class="flex flex-col gap-4 rounded-xl border border-ink-200 bg-white/80 p-5 backdrop-blur-sm transition-shadow hover:shadow-md sm:flex-row dark:border-ink-800 dark:bg-ink-950/80 dark:hover:shadow-ink-900/50"
>
  {
    pub.preview && (
      <div class="w-full shrink-0 sm:w-44">
        <img
          src={withBase(previewUrl(pub.preview))}
          alt={`Preview for ${pub.title}`}
          loading="lazy"
          class="w-full rounded-lg border border-ink-100 object-cover dark:border-ink-800"
        />
      </div>
    )
  }
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-start justify-between gap-2">
      <h3 class="font-serif text-lg font-semibold text-ink-900 dark:text-ink-100">{pub.title}</h3>
      {
        pub.abbr && (
          <span class="shrink-0 rounded-full bg-accent-100 px-2.5 py-0.5 text-xs font-semibold text-accent-800 dark:bg-accent-900/50 dark:text-accent-300">
            {pub.abbr}
          </span>
        )
      }
    </div>
    <p class="mt-1 text-sm text-ink-600 dark:text-ink-400">
      {
        pub.authors.map((a, i) => (
          <span>
            <span class:list={[a.me && 'font-semibold text-ink-900 dark:text-ink-100']}>
              {a.name}
              {a.equal && <sup>*</sup>}
            </span>
            {i < pub.authors.length - 1 && ', '}
          </span>
        ))
      }
    </p>
    <p class="mt-1 text-sm italic text-ink-500 dark:text-ink-400">{pub.venue}{pub.venue && ' · '}{pub.year}</p>
    {pub.hasEqualContribution && <p class="mt-0.5 text-xs text-ink-400 dark:text-ink-500"><sup>*</sup> equal contribution</p>}
    <div class="mt-3 flex flex-wrap gap-2 text-xs font-medium">
      {
        pub.abstract && (
          <button
            type="button"
            class="abstract-toggle rounded-md border border-ink-300 px-2.5 py-1 text-ink-600 hover:bg-ink-100 dark:border-ink-700 dark:text-ink-300 dark:hover:bg-ink-800"
          >
            Abstract
          </button>
        )
      }
      {
        pub.pdf && (
          <a
            href={withBase(pdfUrl(pub.pdf))}
            target="_blank"
            rel="noopener"
            class="rounded-md border border-ink-300 px-2.5 py-1 text-ink-600 hover:bg-ink-100 dark:border-ink-700 dark:text-ink-300 dark:hover:bg-ink-800"
          >
            PDF
          </a>
        )
      }
      {
        pub.html && (
          <a
            href={pub.html}
            target="_blank"
            rel="noopener"
            class="rounded-md border border-ink-300 px-2.5 py-1 text-ink-600 hover:bg-ink-100 dark:border-ink-700 dark:text-ink-300 dark:hover:bg-ink-800"
          >
            Website
          </a>
        )
      }
    </div>
    {
      pub.abstract && (
        <p class="abstract-text mt-3 hidden rounded-lg bg-ink-50 p-3 text-sm leading-relaxed text-ink-600 dark:bg-ink-900 dark:text-ink-300">
          {pub.abstract}
        </p>
      )
    }
  </div>
</article>

<script>
  document.querySelectorAll('.abstract-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      btn.closest('article')?.querySelector('.abstract-text')?.classList.toggle('hidden');
    });
  });
</script>
