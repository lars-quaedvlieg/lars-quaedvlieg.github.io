---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

// Reverse chronological; undated projects sink to the end, ranked by importance.
const projects = (await getCollection('projects', (p) => p.data.visible)).sort((a, b) => {
  const da = a.data.developedDate?.valueOf() ?? 0;
  const db = b.data.developedDate?.valueOf() ?? 0;
  return db - da || b.data.importance - a.data.importance;
});
// Fixed section order; anything unlisted lands at the end.
const CATEGORY_ORDER = ['Research', 'Development'];
const categories = [...new Set(projects.map((p) => p.data.category))].sort((a, b) => {
  const ia = CATEGORY_ORDER.indexOf(a);
  const ib = CATEGORY_ORDER.indexOf(b);
  return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
});
---

<Base title="Projects" description="Research and development projects by Lars Quaedvlieg">
  <div data-evo-block>
    <h1 class="font-serif text-3xl font-bold text-ink-900 dark:text-ink-100">Projects</h1>
    <p class="mt-2 text-ink-500 dark:text-ink-400">A selection of research and side projects I have worked on over the years.</p>
  </div>

  {
    categories.map((category) => (
      <section class="mt-10">
        <h2 class="font-serif text-xl font-bold text-ink-700 dark:text-ink-300" data-evo-block>{category}</h2>
        <div class="mt-4 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {projects
            .filter((p) => p.data.category === category)
            .map((project) => (
              <ProjectCard project={project} />
            ))}
        </div>
      </section>
    ))
  }
</Base>
