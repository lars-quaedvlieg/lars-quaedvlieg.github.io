---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => p.data.visible && !p.data.redirect);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, authors, img, developedDate } = project.data;
// Descriptions migrated from Jekyll may contain inline HTML; meta tags need plain text.
const plainDescription = description?.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
---

<Base title={title} description={plainDescription} ogImage={img} field={false}>
  <article class="mx-auto max-w-3xl" data-evo-block>
    <a href={withBase('/projects')} class="text-sm font-medium text-accent-700 hover:underline dark:text-accent-400">← All projects</a>
    <h1 class="mt-4 font-serif text-3xl font-bold text-ink-900 dark:text-ink-100">{title}</h1>
    {description && <p class="mt-3 text-lg text-ink-600 dark:text-ink-400" set:html={description} />}
    <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-ink-500 dark:text-ink-400">
      {authors && <span>{authors}</span>}
      {developedDate && <span>{developedDate.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}</span>}
    </div>
    {img && <img src={withBase(img)} alt={`Preview of ${title}`} class="mt-6 w-full rounded-xl border border-ink-200 dark:border-ink-800" />}
    <div class="prose mt-8">
      <Content />
    </div>
  </article>
</Base>
